## DISABLE_FAST_SQL_PARSER
-- 18-缩减分区
drop table if exists T_PAR_18_COALESCE_HASH
CREATE TABLE T_PAR_18_COALESCE_HASH (
id INT,
fname VARCHAR(30),
lname VARCHAR(30),
signed DATE,
primary key(signed)
)
PARTITION BY HASH( MONTH(signed) )
PARTITIONS 12
ALTER TABLE T_PAR_18_COALESCE_HASH COALESCE PARTITION 4
show create table T_PAR_18_COALESCE_HASH
Table,Create Table
T_PAR_18_COALESCE_HASH,CREATE TABLE `T_PAR_18_COALESCE_HASH` (
	`id` int(11) DEFAULT NULL,
	`fname` varchar(30) DEFAULT NULL,
	`lname` varchar(30) DEFAULT NULL,
	`signed` date NOT NULL,
	PRIMARY KEY (`signed`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
PARTITION BY HASH(MONTH(`signed`))
PARTITIONS 4
SHOW CREATE TABLE T_PAR_18_COALESCE_HASH
Table,Create Table
T_PAR_18_COALESCE_HASH,CREATE TABLE `T_PAR_18_COALESCE_HASH` (
	`id` int(11) DEFAULT NULL,
	`fname` varchar(30) DEFAULT NULL,
	`lname` varchar(30) DEFAULT NULL,
	`signed` date NOT NULL,
	PRIMARY KEY (`signed`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
PARTITION BY HASH(MONTH(`signed`))
PARTITIONS 4
-- 19-分区表改为非分区表
  drop table if exists T_PAR_19_REMOVE
set auto_partition = false
CREATE TABLE T_PAR_19_REMOVE (
  id INT NOT NULL,
  fname VARCHAR(30),
  lname VARCHAR(30),
  primary key(id)
  )
  PARTITION BY RANGE (id) (
  PARTITION p0 VALUES LESS THAN (50),
  PARTITION p1 VALUES LESS THAN (100),
  PARTITION p2 VALUES LESS THAN (150),
  PARTITION p3 VALUES LESS THAN (MAXVALUE)
  )
ALTER TABLE T_PAR_19_REMOVE REMOVE PARTITIONING
SHOW CREATE TABLE T_PAR_19_REMOVE
Table,Create Table
T_PAR_19_REMOVE,CREATE TABLE `T_PAR_19_REMOVE` (
	`id` int(11) NOT NULL,
	`fname` varchar(30) DEFAULT NULL,
	`lname` varchar(30) DEFAULT NULL,
	PRIMARY KEY (`id`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
SINGLE