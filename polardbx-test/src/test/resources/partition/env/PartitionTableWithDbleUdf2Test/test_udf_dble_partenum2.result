## DISABLE_FAST_SQL_PARSER
set ROUTE_TUPLE_IGNORE_BAD_VALUE_TYPE_CAST=false
drop table if exists partenumstr_t1
create table partenumstr_t1(
c1 varchar(32),
c2 varchar(32)
)
partition by udf_hash(partenumstr(c1))
(
partition p1 values less than(1),
partition p2 values less than(2)
)
select part_route('','partenumstr_t1', null)
part_route('', 'partenumstr_t1', NULL)
p1
select part_route('','partenumstr_t1', '')
part_route('', 'partenumstr_t1', '')
p1
select part_route('','partenumstr_t1', 'x')
part_route('', 'partenumstr_t1', 'x')
p1
select part_route('','partenumstr_t1', '0')
part_route('', 'partenumstr_t1', '0')
p1
select part_route('','partenumstr_t1', 'A')
part_route('', 'partenumstr_t1', 'A')
p1
select part_route('','partenumstr_t1', 'B')
part_route('', 'partenumstr_t1', 'B')
p2
select part_route('','partenumstr_t1', 'C')
part_route('', 'partenumstr_t1', 'C')
p1
drop table if exists partenumstr2_t1
create table partenumstr2_t1(
