## DISABLE_FAST_SQL_PARSER
set ROUTE_TUPLE_IGNORE_BAD_VALUE_TYPE_CAST=false
# mapping, default 2:
  #("5-34"->0)
  #("30-60"->1)
  #("64-96"->2)
drop table if exists pttrrng_t1
create table pttrrng_t1(
c1 bigint not null,
c2 bigint not null
)
partition by udf_hash(pattrngid2p96(c1))
partition 3
(
  partition p0 values less than(1),
  partition p1 values less than(2),
  partition p2 values less than(3)
)
select part_route('', 'pttrrng_t1', null)
part_route('', 'pttrrng_t1', NULL)
p2
## error_msg: $# invalid type conversion #$
select part_route('', 'pttrrng_t1', '')
invalid type conversion
## error_msg: $# invalid type conversion #$
select part_route('', 'pttrrng_t1', 'a')
invalid type conversion
