## DISABLE_FAST_SQL_PARSER
set ROUTE_TUPLE_IGNORE_BAD_VALUE_TYPE_CAST=false
select numrngid0r3(0)
numrngid0r3(0)
0
select numrngid0r3(2000000)
numrngid0r3(2000000)
0
select numrngid0r3(2000001)
numrngid0r3(2000001)
1
select numrngid0r3(4000000)
numrngid0r3(4000000)
1
select numrngid0r3(4000001)
numrngid0r3(4000001)
2
select numrngid0r3(6000000)
numrngid0r3(6000000)
2
select numrngid0r3(6000001)
numrngid0r3(6000001)
0
drop table if exists numrng_t1
create table numrng_t1(
c1 bigint not null,
c2 bigint not null
)
partition by udf_hash(numrngid0r3(c1))
partition 3
(
partition p0 values less than (1),
partition p1 values less than (2),
partition p2 values less than (3)
)
select part_route('','numrng_t1',  null)
part_route('', 'numrng_t1', NULL)
p0
