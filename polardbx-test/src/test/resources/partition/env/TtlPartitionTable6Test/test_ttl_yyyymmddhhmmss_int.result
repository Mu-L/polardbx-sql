	`a` bigint(20) UNSIGNED NOT NULL,
	`b` datetime DEFAULT NULL,
	`c` varchar(32) DEFAULT NULL,
	PRIMARY KEY (`a`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 TTL = TTL_DEFINITION ( TTL_ENABLE = 'OFF', TTL_EXPR = `a` EXPIRE AFTER 2 day TIMEZONE '+08:00', TTL_JOB = CRON '0 0 2 * * ? *', TTL_COL_ENCODER = DATE_FORMAT(?, '%Y%m%d%H%i%s'), TTL_COL_DECODER = STR_TO_DATE(?, '%Y%m%d%H%i%s'), TTL_CLEANUP = 'ON', TTL_PART_INTERVAL = INTERVAL(1, DAY), ARCHIVE_TYPE = 'PARTITION', ARCHIVE_TABLE_NAME = '', ARCHIVE_TABLE_PRE_ALLOCATE = 2, ARCHIVE_TABLE_POST_ALLOCATE = 2 )
PARTITION BY RANGE(`a`)
(PARTITION p3 VALUES LESS THAN (20250603000000) ENGINE = InnoDB,
