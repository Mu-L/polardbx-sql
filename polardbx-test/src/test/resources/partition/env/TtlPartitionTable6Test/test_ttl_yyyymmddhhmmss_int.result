## DISABLE_FAST_SQL_PARSER
set TTL_DEBUG_USE_GSI_FOR_COLUMNAR_ARC_TBL = false
set TTL_DEBUG_CCI_SKIP_DDL_TASKS = "WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask"
set SKIP_DDL_TASKS="WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask"
set sql_mode=''
drop table if exists r_yyyymmddhhmmss
create table r_yyyymmddhhmmss
(
a bigint unsigned,
b datetime,
c varchar(32),
primary key(a)
)
partition by range(a)
(
partition p1 values less than(20250601000000),
partition p2 values less than(20250602000000),
partition p3 values less than(20250603000000),
partition p4 values less than(20250604000000),
partition p5 values less than(20250605000000)
)
alter table r_yyyymmddhhmmss modify ttl
set
ttl_enable='off',
ttl_cleanup='on',
ttl_expr = `a` expire after 2 day timezone '+08:00',
ttl_part_interval=interval(1,day),
ttl_col_encoder=date_format(?, '%Y%m%d%H%i%s'),
ttl_col_decoder=str_to_date(?, '%Y%m%d%H%i%s'),
archive_type='partition',
archive_table_pre_allocate = 2,
archive_table_post_allocate = 2
set TTL_DEBUG_CURRENT_DATETIME='2025-06-04 00:00:00'
alter table r_yyyymmddhhmmss cleanup expired data
