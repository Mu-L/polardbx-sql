drop table if exists r_unix_ts;
create table r_unix_ts
(
a int ,
b datetime,
c varchar(32),
primary key(a)
)
partition by range(a)
(
partition p20250501 values less than(1746028800),
partition p20250502 values less than(1746115200),
partition p20250503 values less than(1746201600),
partition p20250504 values less than(1746288000),
partition p20250505 values less than(1746374400)
);
alter table r_unix_ts modify ttl
set
ttl_enable='off',
ttl_cleanup='on',
ttl_expr = `a` expire after 1 day timezone '+08:00',
ttl_part_interval=interval(1,day),
ttl_col_encoder=unix_timestamp(?),
ttl_col_decoder=from_unixtime(?),
archive_type='partition',
archive_table_pre_allocate = 2,
archive_table_post_allocate = 2;
set TTL_DEBUG_CURRENT_DATETIME='2025-06-27 00:00:00';
alter table r_unix_ts cleanup expired data;
