## DISABLE_FAST_SQL_PARSER
set TTL_DEBUG_USE_GSI_FOR_COLUMNAR_ARC_TBL = false
set TTL_DEBUG_CCI_SKIP_DDL_TASKS = "WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask"
set SKIP_DDL_TASKS="WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask"
set sql_mode=''
drop table if exists r_yymmdd
create table r_yymmdd
(
a int ,
b datetime,
c varchar(32),
primary key(a)
)
partition by range(a)
(
partition p1 values less than(250601),
partition p2 values less than(250602),
partition p3 values less than(250603),
partition p4 values less than(250604),
partition p5 values less than(250605)
)
alter table r_yymmdd modify ttl
set
ttl_enable='off',
ttl_cleanup='on',
ttl_expr = `a` expire after 2 day timezone '+08:00',
ttl_part_interval=interval(1,day),
ttl_col_encoder=date_format(?, '%y%m%d'),
ttl_col_decoder=str_to_date(?, '%y%m%d'),
archive_type='partition',
archive_table_pre_allocate = 2,
archive_table_post_allocate = 2
set TTL_DEBUG_CURRENT_DATETIME='2025-06-04 00:00:00'
alter table r_yymmdd cleanup expired data
show create table r_yymmdd
Table,Create Table
r_yymmdd,CREATE TABLE `r_yymmdd` (
	`a` int(11) NOT NULL,
	`b` datetime DEFAULT NULL,
	`c` varchar(32) DEFAULT NULL,
	PRIMARY KEY (`a`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 TTL = TTL_DEFINITION ( TTL_ENABLE = 'OFF', TTL_EXPR = `a` EXPIRE AFTER 2 day TIMEZONE '+08:00', TTL_JOB = CRON '0 0 2 * * ? *', TTL_COL_ENCODER = DATE_FORMAT(?, '%y%m%d'), TTL_COL_DECODER = STR_TO_DATE(?, '%y%m%d'), TTL_CLEANUP = 'ON', TTL_PART_INTERVAL = INTERVAL(1, DAY), ARCHIVE_TYPE = 'PARTITION', ARCHIVE_TABLE_NAME = '', ARCHIVE_TABLE_PRE_ALLOCATE = 2, ARCHIVE_TABLE_POST_ALLOCATE = 2 )
PARTITION BY RANGE(`a`)
(PARTITION p3 VALUES LESS THAN (250603) ENGINE = InnoDB,
 PARTITION p4 VALUES LESS THAN (250604) ENGINE = InnoDB,
 PARTITION p5 VALUES LESS THAN (250605) ENGINE = InnoDB,
 PARTITION p20250606 VALUES LESS THAN (250606) ENGINE = InnoDB,
 PARTITION p20250607 VALUES LESS THAN (250607) ENGINE = InnoDB)
