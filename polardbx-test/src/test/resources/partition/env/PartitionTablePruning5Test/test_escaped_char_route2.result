`b` varchar(8) DEFAULT NULL
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 COLLATE = utf8mb4_general_ci
PARTITION BY RANGE COLUMNS(`a`,`b`)
(
PARTITION p1 VALUES LESS THAN('',''),
