CREATE TABLE `rng_esc_route_t1` (
`a` varchar(8) DEFAULT NULL,
`b` varchar(8) DEFAULT NULL
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 COLLATE = utf8mb4_general_ci
PARTITION BY RANGE COLUMNS(`a`)
(
PARTITION p1 VALUES LESS THAN(''),
PARTITION p2 VALUES LESS THAN('"'),
PARTITION p3 VALUES LESS THAN('\''),
PARTITION p4 VALUES LESS THAN('\\'),
PARTITION p5 VALUES LESS THAN('\\n'),
PARTITION p6 VALUES LESS THAN('\\r'),
PARTITION p7 VALUES LESS THAN('\\t'),
PARTITION p8 VALUES LESS THAN('\\\\'),
PARTITION p9 VALUES LESS THAN(MAXVALUE)
);
