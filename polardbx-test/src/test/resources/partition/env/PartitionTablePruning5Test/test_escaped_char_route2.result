	KEY `auto_shard_key_a` USING BTREE (`a`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
PARTITION BY RANGE COLUMNS(`a`)
(PARTITION p1 VALUES LESS THAN ('') ENGINE = InnoDB,
 PARTITION p2 VALUES LESS THAN ('"') ENGINE = InnoDB,
 PARTITION p3 VALUES LESS THAN ('''') ENGINE = InnoDB,
 PARTITION p4 VALUES LESS THAN ('\\') ENGINE = InnoDB,
 PARTITION p5 VALUES LESS THAN ('\\n') ENGINE = InnoDB,
 PARTITION p6 VALUES LESS THAN ('\\r') ENGINE = InnoDB,
 PARTITION p7 VALUES LESS THAN ('\\t') ENGINE = InnoDB,
 PARTITION p8 VALUES LESS THAN ('\\\\') ENGINE = InnoDB,
 PARTITION p9 VALUES LESS THAN (MAXVALUE) ENGINE = InnoDB)
