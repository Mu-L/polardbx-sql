## DISABLE_FAST_SQL_PARSER
set TTL_DEBUG_USE_GSI_FOR_COLUMNAR_ARC_TBL = false
set TTL_DEBUG_CCI_SKIP_DDL_TASKS = "WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask"
set TTL_DEBUG_CURRENT_DATETIME='2025-09-01 00:00:00'
set SKIP_DDL_TASKS="WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask"
create table test_cci_split_gap_ms(
a int not null auto_increment,
b bigint not null,
primary key(a)
)
ttl = ttl_definition( TTL_ENABLE = 'OFF' TTL_EXPR = FROM_UNIXTIME(`b`/1000) EXPIRE AFTER 2 MONTH TIMEZONE '+08:00' TTL_JOB = CRON '0 0 1 */2 * ? *' TIMEZONE '+08:00' ARCHIVE_TABLE_PRE_ALLOCATE = 2 ARCHIVE_TABLE_POST_ALLOCATE = 2 )
partition by key(a) partitions 2
show create table test_cci_split_gap_ms
Table,Create Table
test_cci_split_gap_ms,CREATE TABLE `test_cci_split_gap_ms` (
	`a` int NOT NULL AUTO_INCREMENT,
	`b` bigint NOT NULL,
	PRIMARY KEY (`a`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 TTL = TTL_DEFINITION ( TTL_ENABLE = 'OFF', TTL_EXPR = FROM_UNIXTIME(`b` / 1000) EXPIRE AFTER 2 MONTH TIMEZONE '+08:00', TTL_JOB = CRON '0 0 1 */2 * ? *', TTL_CLEANUP = 'OFF', TTL_PART_INTERVAL = INTERVAL(1, MONTH), ARCHIVE_TYPE = 'ROW', ARCHIVE_TABLE_NAME = '', ARCHIVE_TABLE_PRE_ALLOCATE = 2, ARCHIVE_TABLE_POST_ALLOCATE = 2 )
PARTITION BY KEY(`a`)
PARTITIONS 2
create table test_cci_split_gap_ms_bk like test_cci_split_gap_ms engine='columnar' archive_mode='ttl'
show create table test_cci_split_gap_ms
Table,Create Table
test_cci_split_gap_ms,CREATE TABLE `test_cci_split_gap_ms` (
	`a` int NOT NULL AUTO_INCREMENT,
	`b` bigint NOT NULL,
	PRIMARY KEY (`a`),
	CLUSTERED COLUMNAR INDEX `arctmp_test_cci_split_gap_ms_bk` (`b`)
		PARTITION BY RANGE COLUMNS(`b`)
		(PARTITION p20250701 VALUES LESS THAN (1751299200000) ENGINE = Columnar,
		 PARTITION p20250801 VALUES LESS THAN (1753977600000) ENGINE = Columnar,
		 PARTITION p20250901 VALUES LESS THAN (1756656000000) ENGINE = Columnar,
		 PARTITION p20251001 VALUES LESS THAN (1759248000000) ENGINE = Columnar,
		 PARTITION p20251101 VALUES LESS THAN (1761926400000) ENGINE = Columnar,
		 PARTITION p20251201 VALUES LESS THAN (1764518400000) ENGINE = Columnar,
		 PARTITION pmax VALUES LESS THAN (MAXVALUE) ENGINE = Columnar)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 TTL = TTL_DEFINITION ( TTL_ENABLE = 'OFF', TTL_EXPR = FROM_UNIXTIME(`b` / 1000) EXPIRE AFTER 2 MONTH TIMEZONE '+08:00', TTL_JOB = CRON '0 0 1 */2 * ? *', TTL_CLEANUP = 'OFF', TTL_PART_INTERVAL = INTERVAL(1, MONTH), ARCHIVE_TYPE = 'ROW', ARCHIVE_TABLE_NAME = 'test_cci_split_gap_ms_bk', ARCHIVE_TABLE_PRE_ALLOCATE = 2, ARCHIVE_TABLE_POST_ALLOCATE = 2 )
PARTITION BY KEY(`a`)
PARTITIONS 2
## split pmax to build a large gap with far-future reserved partitions
alter index arctmp_test_cci_split_gap_ms_bk on table test_cci_split_gap_ms
  split partition pmax into (
    partition p20980101 values less than (4039344000000),
    partition p20990101 values less than (4070880000000),
    partition p21000101 values less than (4102416000000),
    partition pmax values less than (maxvalue)
  )
show create table test_cci_split_gap_ms
Table,Create Table
test_cci_split_gap_ms,CREATE TABLE `test_cci_split_gap_ms` (
	`a` int NOT NULL AUTO_INCREMENT,
	`b` bigint NOT NULL,
	PRIMARY KEY (`a`),
	CLUSTERED COLUMNAR INDEX `arctmp_test_cci_split_gap_ms_bk` (`b`)
		PARTITION BY RANGE COLUMNS(`b`)
		(PARTITION p20250701 VALUES LESS THAN (1751299200000) ENGINE = Columnar,
		 PARTITION p20250801 VALUES LESS THAN (1753977600000) ENGINE = Columnar,
		 PARTITION p20250901 VALUES LESS THAN (1756656000000) ENGINE = Columnar,
		 PARTITION p20251001 VALUES LESS THAN (1759248000000) ENGINE = Columnar,
		 PARTITION p20251101 VALUES LESS THAN (1761926400000) ENGINE = Columnar,
		 PARTITION p20251201 VALUES LESS THAN (1764518400000) ENGINE = Columnar,
		 PARTITION p20980101 VALUES LESS THAN (4039344000000) ENGINE = Columnar,
		 PARTITION p20990101 VALUES LESS THAN (4070880000000) ENGINE = Columnar,
		 PARTITION p21000101 VALUES LESS THAN (4102416000000) ENGINE = Columnar,
		 PARTITION pmax VALUES LESS THAN (MAXVALUE) ENGINE = Columnar)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 TTL = TTL_DEFINITION ( TTL_ENABLE = 'OFF', TTL_EXPR = FROM_UNIXTIME(`b` / 1000) EXPIRE AFTER 2 MONTH TIMEZONE '+08:00', TTL_JOB = CRON '0 0 1 */2 * ? *', TTL_CLEANUP = 'OFF', TTL_PART_INTERVAL = INTERVAL(1, MONTH), ARCHIVE_TYPE = 'ROW', ARCHIVE_TABLE_NAME = 'test_cci_split_gap_ms_bk', ARCHIVE_TABLE_PRE_ALLOCATE = 2, ARCHIVE_TABLE_POST_ALLOCATE = 2 )
PARTITION BY KEY(`a`)
PARTITIONS 2
## enable nearest split + reserved gap threshold, should split from the nearest reserved part
alter table test_cci_split_gap_ms modify ttl set ARCHIVE_TABLE_PRE_ALLOCATE=7
/*+TDDL:cmd_extra(TTL_ENABLE_CCI_SPLIT_FROM_NEAREST_PART=true,TTL_CCI_RESERVED_PART_GAP_COUNT=24)*/ alter table test_cci_split_gap_ms cleanup expired data
