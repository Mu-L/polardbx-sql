## DISABLE_FAST_SQL_PARSER
set TTL_DEBUG_USE_GSI_FOR_COLUMNAR_ARC_TBL = false
set TTL_DEBUG_CCI_SKIP_DDL_TASKS = "WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask"
set TTL_DEBUG_CURRENT_DATETIME='2024-06-27 00:00:00'
set SKIP_DDL_TASKS="WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask"
set TTL_FORBID_DROP_TTL_TBL_WITH_ARC_CCI = false
drop table if exists test_invalid_modify_ttl
## create table
create table test_invalid_modify_ttl(
a int not null,
b datetime,
c int,
primary key(a)
)
partition by key(`a`)
partitions 4
alter table test_invalid_modify_ttl
modify ttl set
ttl_enable = 'off',
ttl_cleanup = 'on',
ttl_expr = `b` expire after 1 day timezone '+08:00'
archive_table_pre_allocate=1,
archive_table_post_allocate=8
show create table test_invalid_modify_ttl
Table,Create Table
test_invalid_modify_ttl,CREATE TABLE `test_invalid_modify_ttl` (
	`a` int(11) NOT NULL,
	`b` datetime DEFAULT NULL,
	`c` int(11) DEFAULT NULL,
	PRIMARY KEY (`a`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 TTL = TTL_DEFINITION ( TTL_ENABLE = 'OFF', TTL_EXPR = `b` EXPIRE AFTER 1 day TIMEZONE '+08:00', TTL_JOB = CRON '0 0 2 * * ? *', TTL_CLEANUP = 'ON', TTL_PART_INTERVAL = INTERVAL(1, DAY), ARCHIVE_TYPE = 'ROW', ARCHIVE_TABLE_NAME = '', ARCHIVE_TABLE_PRE_ALLOCATE = 1, ARCHIVE_TABLE_POST_ALLOCATE = 8 )
PARTITION BY KEY(`a`)
PARTITIONS 4
alter table test_invalid_modify_ttl
modify ttl set
archive_table_pre_allocate=3,
show create table test_invalid_modify_ttl
Table,Create Table
test_invalid_modify_ttl,CREATE TABLE `test_invalid_modify_ttl` (
	`a` int(11) NOT NULL,
	`b` datetime DEFAULT NULL,
	`c` int(11) DEFAULT NULL,
	PRIMARY KEY (`a`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 TTL = TTL_DEFINITION ( TTL_ENABLE = 'OFF', TTL_EXPR = `b` EXPIRE AFTER 1 day TIMEZONE '+08:00', TTL_JOB = CRON '0 0 2 * * ? *', TTL_CLEANUP = 'ON', TTL_PART_INTERVAL = INTERVAL(1, DAY), ARCHIVE_TYPE = 'ROW', ARCHIVE_TABLE_NAME = '', ARCHIVE_TABLE_PRE_ALLOCATE = 3, ARCHIVE_TABLE_POST_ALLOCATE = 8 )
PARTITION BY KEY(`a`)
PARTITIONS 4
drop table test_invalid_modify_ttl;