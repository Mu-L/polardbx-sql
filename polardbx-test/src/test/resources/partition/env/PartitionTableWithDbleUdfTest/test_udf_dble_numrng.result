drop tablegroup if exists tg_dble_udf6
create tablegroup if not exists tg_dble_udf6
partition by udf_hash(bigint)
partition 4
(
partition p0 values less than (1),
partition p1 values less than (2),
partition p2 values less than (3),
partition pm values less than (9223372036854775807)
)
drop table if exists uh_t6
create table uh_t6(
c1 bigint not null,
c2 bigint not null
)
partition by udf_hash(numrngd0r3i(c1))
tablegroup=tg_dble_udf6
