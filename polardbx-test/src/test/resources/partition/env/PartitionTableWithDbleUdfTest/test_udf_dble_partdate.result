drop tablegroup if exists tg_dble_udf8
create tablegroup if not exists tg_dble_udf8
partition by udf_hash(bigint)
partition 4
(
partition p0 values less than (1),
partition p1 values less than (2),
partition p2 values less than (3),
partition pm values less than (9223372036854775807)
)
drop table if exists uh_t8
create table uh_t8(
c1 varchar(32) not null,
c2 varchar(32) not null
)
partition by udf_hash(partdated0sp10(c1))
tablegroup=tg_dble_udf8
