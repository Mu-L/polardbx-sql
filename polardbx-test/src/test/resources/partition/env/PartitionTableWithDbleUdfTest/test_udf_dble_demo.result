dbledemo('1')
746762829127501960
drop tablegroup if exists dble_pl_var_tg
create tablegroup if not exists dble_pl_var_tg
partition by udf_hash(bigint)
partition 6
(
partition p1 values less than (2),
partition p2 values less than (3),
partition p3 values less than (4),
partition p4 values less than (5),
partition p5 values less than (6),
partition p6 values less than (9223372036854775807)
)
drop table if exists uh_t1
create table uh_t1(
c1 varchar(32) not null,
c2 varchar(32) not null
)
partition by udf_hash(dbledemo(c1))
tablegroup=dble_pl_var_tg
insert into uh_t1 values ('1','1'),('2','2'),('3','3'),('4','4')
select c1, part_route('', 'uh_t1', c1) as route_rs, part_hash('', 'uh_t1', c1) as hash_rs from uh_t1 where c1=1
c1,route_rs,hash_rs
