show create table uh_t11
Table,Create Table
uh_t11,CREATE TABLE `uh_t11` (
	`c1` datetime NOT NULL,
	`c2` datetime NOT NULL,
	KEY `auto_shard_key_c1` USING BTREE (`c1`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
PARTITION BY UDF_HASH(partdated0sp10d(`c1`))
PARTITIONS 4
(PARTITION p0 VALUES LESS THAN (1) ENGINE = InnoDB,
 PARTITION p1 VALUES LESS THAN (2) ENGINE = InnoDB,
 PARTITION p2 VALUES LESS THAN (3) ENGINE = InnoDB,
 PARTITION pm VALUES LESS THAN (9223372036854775807) ENGINE = InnoDB)
tablegroup = `tg_dble_udf11`
