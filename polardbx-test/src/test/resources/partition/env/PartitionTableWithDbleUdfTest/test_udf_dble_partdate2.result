drop tablegroup if exists tg_dble_udf11
create tablegroup if not exists tg_dble_udf11
partition by udf_hash(bigint)
partition 4
(
partition p0 values less than (1),
partition p1 values less than (2),
partition p2 values less than (3),
partition pm values less than (9223372036854775807)
)
drop table if exists uh_t11
create table uh_t11(
c1 datetime not null,
c2 datetime not null
)
partition by udf_hash(Partdated0sp10d(c1))
