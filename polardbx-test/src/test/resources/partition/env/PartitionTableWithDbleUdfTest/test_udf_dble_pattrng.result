drop tablegroup if exists tg_dble_udf7
create tablegroup if not exists tg_dble_udf7
partition by udf_hash(bigint)
partition 9
(
partition p0 values less than (1),
partition p1 values less than (2),
partition p2 values less than (3),
partition p3 values less than (4),
partition p4 values less than (5),
partition p5 values less than (6),
partition p6 values less than (7),
partition p7 values less than (8),
partition pm values less than (9223372036854775807)
)
drop table if exists uh_t7
create table uh_t7(
c1 bigint not null,
c2 bigint not null
)
partition by udf_hash(pattrngd2p256i(c1))
tablegroup=tg_dble_udf7
