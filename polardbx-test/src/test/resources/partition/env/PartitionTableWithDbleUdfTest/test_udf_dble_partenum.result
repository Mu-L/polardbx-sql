drop tablegroup if exists tg_dble_udf4
create tablegroup if not exists tg_dble_udf4
partition by udf_hash(bigint)
partition 3
(
partition p0 values less than (1),
partition p1 values less than (2),
partition pm values less than (9223372036854775807)
)
drop table if exists uh_t4
create table uh_t4(
c1 bigint not null,
c2 bigint not null
)
partition by udf_hash(Partenumt0d0i(c1))
tablegroup=tg_dble_udf4
insert into uh_t4 values (10000,10000)
insert into uh_t4 values (10010,10010)
insert into uh_t4 values (10020,10020)
select c1, part_route('', 'uh_t4', c1) as route_rs, part_hash('', 'uh_t4', c1) as hash_rs from uh_t4 where c1=10000
c1,route_rs,hash_rs
10000,p0,(0)
