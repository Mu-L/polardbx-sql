# Test with string partition key
create table t2_string
(
  id varchar(64),
  name varchar(64),
  age int,
  salary decimal(10,2),
  create_time datetime,
  is_active boolean
)
partition by key(id)
partitions 3;
# Insert test data covering various string types and edge cases
insert into t2_string values ('', 'empty string', 25, 50000.00, '2023-01-01 00:00:00', true);
insert into t2_string values ('0', 'zero string', 30, 60000.50, '2023-01-01 00:00:01', false);
insert into t2_string values ('1', 'one string', 35, 70000.75, '2023-01-01 00:00:02', true);
insert into t2_string values ('-1', 'negative one string', 40, 80000.00, '2023-01-01 00:00:03', false);
insert into t2_string values ('null', 'null string', 45, 90000.25, '2023-01-01 00:00:04', true);
insert into t2_string values (null, 'actual null', 50, 100000.50, '2023-01-01 00:00:05', false);
insert into t2_string values ('abcdefghijklmnopqrstuvwxyz', 'long string', 55, 110000.75, '2023-01-01 00:00:06', true);
insert into t2_string values ('1234567890123456789012345678901234567890123456789012345678901234', '64 char string', 60, 120000.00, '2023-01-01 00:00:07', false);
insert into t2_string values ('中文测试', 'chinese string', 65, 130000.25, '2023-01-01 00:00:08', true);
insert into t2_string values ('🌟emoji🌟', 'emoji string', 70, 140000.50, '2023-01-01 00:00:09', false);
# Insert invalid string data
insert into t2_string values ('This is a very long string that should be truncated to fit in the varchar(64) field', 'truncated string', 75, 150000.00, '2023-01-01 00:00:10', false);
