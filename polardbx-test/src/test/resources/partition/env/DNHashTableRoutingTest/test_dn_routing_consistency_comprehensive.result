## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS
# Set SQL mode to allow invalid data insertion
set sql_mode='';
# Create a 3-partition table for comprehensive testing
create table t2_comprehensive
(
  id bigint,
  name varchar(64),
  age int,
  salary decimal(10,2),
  create_time datetime,
  is_active boolean
)
partition by key(id)
partitions 3;
# Insert comprehensive test data covering various data types and edge cases
# Basic integers
insert into t2_comprehensive values (0, 'zero', 25, 50000.00, '2023-01-01 00:00:00', true);
insert into t2_comprehensive values (1, 'one', 30, 60000.50, '2023-01-01 00:00:01', false);
insert into t2_comprehensive values (-1, 'negative one', 35, 70000.75, '2023-01-01 00:00:02', true);
# Boundary values for bigint
insert into t2_comprehensive values (9223372036854775807, 'max bigint', 40, 80000.00, '2023-01-01 00:00:03', false);
insert into t2_comprehensive values (-9223372036854775808, 'min bigint', 45, 90000.25, '2023-01-01 00:00:04', true);
# Boundary values for int
insert into t2_comprehensive values (2147483647, 'max int', 50, 100000.50, '2023-01-01 00:00:05', false);
insert into t2_comprehensive values (-2147483648, 'min int', 55, 110000.75, '2023-01-01 00:00:06', true);
# NULL values
insert into t2_comprehensive values (null, 'null id', 60, 120000.00, '2023-01-01 00:00:07', false);
# Regular positive and negative numbers
insert into t2_comprehensive values (123456789, 'positive number', 65, 130000.25, '2023-01-01 00:00:08', true);
insert into t2_comprehensive values (-123456789, 'negative number', 70, 140000.50, '2023-01-01 00:00:09', false);
# Duplicate values to test consistency
insert into t2_comprehensive values (0, 'zero duplicate', 75, 150000.75, '2023-01-01 00:00:10', true);
insert into t2_comprehensive values (1, 'one duplicate', 80, 160000.00, '2023-01-01 00:00:11', false);
# Additional edge cases for comprehensive testing
insert into t2_comprehensive values (999999999999999999, 'large positive', 85, 170000.25, '2023-01-01 00:00:12', true);
insert into t2_comprehensive values (-999999999999999999, 'large negative', 90, 180000.50, '2023-01-01 00:00:13', false);
# Insert invalid data that would normally be rejected
# Truncated string values
insert into t2_comprehensive values (2, 'This is a very long string that should be truncated to fit in the varchar(64) field', 100, 200000.00, '2023-01-01 00:00:14', true);
# Test part_hash function on CN to get expected hash values
select id, part_hash('', 't2_comprehensive', id) as cn_hash_value from t2_comprehensive order by id;
id,cn_hash_value
null,(-2447670524089286488)
-9223372036854775808,(-766309672757065757)
