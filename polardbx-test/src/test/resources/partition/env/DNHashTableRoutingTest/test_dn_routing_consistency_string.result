# UTF8MB4 charset with utf8mb4_unicode_ci collation
create table t2_string_utf8mb4_unicode
(
  id varchar(64) charset utf8mb4 collate utf8mb4_unicode_ci,
  name varchar(64),
  age int,
  salary decimal(10,2),
  create_time datetime,
  is_active boolean
)
partition by key(id)
partitions 3;
# Insert test data for UTF8MB4 unicode collation
insert into t2_string_utf8mb4_unicode values ('', 'empty string', 25, 50000.00, '2023-01-01 00:00:00', true);
insert into t2_string_utf8mb4_unicode values ('ABC', 'uppercase', 30, 60000.50, '2023-01-01 00:00:01', false);
insert into t2_string_utf8mb4_unicode values ('abc', 'lowercase', 35, 70000.75, '2023-01-01 00:00:02', true);
insert into t2_string_utf8mb4_unicode values ('中文测试', 'chinese string', 40, 80000.00, '2023-01-01 00:00:03', false);
insert into t2_string_utf8mb4_unicode values ('🌟emoji🌟', 'emoji string', 45, 90000.25, '2023-01-01 00:00:04', true);
# Insert invalid string data
insert into t2_string_utf8mb4_unicode values ('This is a very long string that should be truncated to fit in the varchar(64) field', 'truncated string', 50, 100000.00, '2023-01-01 00:00:05', false);
# Test part_hash function on CN for UTF8MB4 unicode collation table
select id, part_hash('', 't2_string_utf8mb4_unicode', id) as hash_value from t2_string_utf8mb4_unicode order by id;
