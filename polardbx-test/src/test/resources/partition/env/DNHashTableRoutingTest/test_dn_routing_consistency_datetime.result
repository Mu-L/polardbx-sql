## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS
# Set SQL mode to allow invalid data insertion
set sql_mode='';
# Create a 3-partition table for testing with datetime partition key
create table t2_datetime
(
  id bigint,
  name varchar(64),
  age int,
  salary decimal(10,2),
  create_time datetime,
  is_active boolean
)
partition by key(create_time)
partitions 3;
# Insert test data covering various datetime types and edge cases
insert into t2_datetime values (1, 'epoch record 1', 25, 50000.00, '1970-01-01 00:00:00', true);
insert into t2_datetime values (2, 'epoch plus one second', 30, 60000.50, '1970-01-01 00:00:01', false);
insert into t2_datetime values (3, 'y2k record', 35, 70000.75, '2000-01-01 00:00:00', true);
insert into t2_datetime values (4, '32-bit signed int max', 40, 80000.00, '2038-01-19 03:14:07', false);
insert into t2_datetime values (5, 'null datetime', 45, 90000.25, null, true);
insert into t2_datetime values (6, 'very old date', 50, 100000.50, '1000-01-01 00:00:00', false);
insert into t2_datetime values (7, 'far future date', 55, 110000.75, '9999-12-31 23:59:59', true);
insert into t2_datetime values (8, 'invalid feb 29', 60, 120000.00, '2023-02-29 12:30:45', false);
insert into t2_datetime values (9, 'epoch record 2', 65, 130000.25, '1970-01-01 00:00:00', true);
insert into t2_datetime values (10, 'y2k record 2', 70, 140000.50, '2000-01-01 00:00:00', false);
# Insert invalid datetime data
insert into t2_datetime values (11, 'invalid date format', 75, 150000.00, 'invalid-date', true);
insert into t2_datetime values (12, 'invalid date values', 80, 160000.00, '2023-13-01 25:70:80', false);
# Test part_hash function on CN
select create_time, part_hash('', 't2_datetime', create_time) as hash_value from t2_datetime order by create_time;
