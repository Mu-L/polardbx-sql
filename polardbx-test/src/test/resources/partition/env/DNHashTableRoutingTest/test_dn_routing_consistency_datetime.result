# Latin1 charset with latin1_swedish_ci collation
create table t2_string_latin1
(
  id varchar(64) charset latin1 collate latin1_swedish_ci,
  name varchar(64),
  age int,
  salary decimal(10,2),
  create_time datetime,
  is_active boolean
)
partition by key(id)
partitions 3;
# Insert test data for Latin1 charset
insert into t2_string_latin1 values ('', 'empty string', 25, 50000.00, '2023-01-01 00:00:00', true);
insert into t2_string_latin1 values ('ABC', 'uppercase', 30, 60000.50, '2023-01-01 00:00:01', false);
insert into t2_string_latin1 values ('abc', 'lowercase', 35, 70000.75, '2023-01-01 00:00:02', true);
insert into t2_string_latin1 values ('123', 'numbers', 40, 80000.00, '2023-01-01 00:00:03', false);
insert into t2_string_latin1 values ('!@#', 'special chars', 45, 90000.25, '2023-01-01 00:00:04', true);
# Insert invalid string data
insert into t2_string_latin1 values ('This is a very long string that should be truncated to fit in the varchar(64) field', 'truncated string', 50, 100000.00, '2023-01-01 00:00:05', false);
# Test part_hash function on CN for Latin1 table
select id, part_hash('', 't2_string_latin1', id) as hash_value from t2_string_latin1 order by id;
