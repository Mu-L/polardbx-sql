## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
use polardbx;
drop database if exists test_omc30_rb_hint_db;
create database if not exists test_omc30_rb_hint_db mode='auto' default character set utf8mb4 default collate utf8mb4_bin;
use test_omc30_rb_hint_db;
## case: OMC backfill hint params propagated from "alter table cleanup expired data"
## to CheckAndPrepareCleanupDataByRebuildPolicyTask and injected into rebuild sub-job SQL.
## The rebuild policy is forced on, and OMC tuning params (parallelism, speed, catchup)
## are passed via the same hint.  If propagation works, the rebuild completes and
## expired rows are removed while valid rows survive.
drop table if exists rb_hint_t1;
create table rb_hint_t1(
  a int not null,
  b datetime not null,
  c varchar(32),
  primary key(a)
) default character set utf8mb4 default collate utf8mb4_bin
partition by hash(a) partitions 4;
alter table rb_hint_t1 modify ttl set
  TTL_ENABLE='on',
  TTL_CLEANUP='on',
  TTL_EXPR=`b` expire after 1 day timezone '+08:00';
insert into rb_hint_t1 values(1, '2020-06-01 00:00:00', 'expired1');
insert into rb_hint_t1 values(2, '2020-06-02 00:00:00', 'expired2');
insert into rb_hint_t1 values(3, '2020-06-03 00:00:00', 'expired3');
insert into rb_hint_t1 values(4, '2030-06-01 00:00:00', 'valid1');
insert into rb_hint_t1 values(5, '2030-06-02 00:00:00', 'valid2');
set TTL_DEBUG_CURRENT_DATETIME='2025-01-01 00:00:00';
select a, c from rb_hint_t1 order by a;
a,c
1,expired1
2,expired2
3,expired3
4,valid1
5,valid2
## trigger cleanup with rebuild policy + OMC backfill tuning hints
/*+TDDL:CMD_EXTRA(TTL_ENABLE_CLEANUP_EXPIRED_DATA_BY_REBUILD_POLICY=true,TTL_FORCE_USE_REBUILD_POLICY_FOR_CLEANUP_EXPIRED_DATA=true,TTL_MIN_ROW_COUNT_FOR_AUTO_USING_REBUILD_POLICY=0,TTL_EXPIRED_DATA_PERCENT_FOR_AUTO_USING_REBUILD_POLICY=0,OMC_BACKFILL_PARALLELISM=3,OMC_BACKFILL_SPEED_MIN=150000,OMC_BACKFILL_SPEED_LIMITATION=300000,OMC_CATCHUP_LOOP_COUNT_BEFORE_BP=10)*/alter table rb_hint_t1 cleanup expired data;
## verify: only valid rows remain (proves rebuild with OMC hints completed successfully)
select a, c from rb_hint_t1 order by a;
a,c
4,valid1
5,valid2
drop table if exists rb_hint_t1;
use polardbx;
drop database if exists test_omc30_rb_hint_db;
use polardbx;
