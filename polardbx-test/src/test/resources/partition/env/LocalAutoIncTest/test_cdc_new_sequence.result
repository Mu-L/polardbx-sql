SET ENABLE_PUSH_DOWN_AUTO_INCREMENT = true
USE __cdc__
DROP TABLE IF EXISTS `__cdc_ddl_record_test__`
DROP TABLE IF EXISTS `t1`
DROP TABLE IF EXISTS `t2`
CREATE TABLE `__cdc_ddl_record_test__` (
	`ID` bigint(20) NOT NULL AUTO_INCREMENT,
	`JOB_ID` bigint(20) DEFAULT NULL,
	`SQL_KIND` varchar(50) NOT NULL,
	`SCHEMA_NAME` varchar(200) NOT NULL,
	`TABLE_NAME` varchar(200) DEFAULT NULL,
	`GMT_CREATED` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
	`DDL_SQL` mediumtext NOT NULL,
	`META_INFO` mediumtext,
	`VISIBILITY` bigint(10) NOT NULL,
	`EXT` text,
	PRIMARY KEY (`ID`),
	KEY `idx_job_id` (`JOB_ID`)
) BROADCAST ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
CREATE TABLE t1 (
	a int PRIMARY KEY AUTO_INCREMENT,
	b int
)
DBPARTITION BY hash(b)
CREATE TABLE t2 (
	a int PRIMARY KEY AUTO_INCREMENT,
	b int
) SINGLE
