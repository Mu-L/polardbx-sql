set TTL_FORBID_DROP_TTL_TBL_WITH_ARC_CCI = false;
set ENABLE_LOGICAL_TABLE_META=true;
drop database if exists alter_ttl_db3;
create database if not exists alter_ttl_db3 mode='auto';
use alter_ttl_db3;
drop table if exists part_with_arc;
create table part_with_arc (
a int,
name varchar(20),
created_at datetime,
b int,
primary key(a))
partition by key(a)
partitions 4;
alter table part_with_arc modify ttl set
TTL_EXPR = created_at EXPIRE AFTER 3 DAY TIMEZONE '+08:00',
TTL_ENABLE = 'OFF',
TTL_CLEANUP = 'ON',
TTL_PART_INTERVAL = INTERVAL(1, DAY),
ARCHIVE_TABLE_POST_ALLOCATE = 8;
create table part_with_arc_bk like part_with_arc engine=Columnar archive_mode='ttl';
show create table part_with_arc;
