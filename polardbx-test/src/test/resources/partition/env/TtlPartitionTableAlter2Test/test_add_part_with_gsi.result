## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
set TTL_DEBUG_USE_GSI_FOR_COLUMNAR_ARC_TBL = false;
set TTL_DEBUG_CCI_SKIP_DDL_TASKS = "WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask";
set TTL_DEBUG_CURRENT_DATETIME='2024-06-27 00:00:00';
set SKIP_DDL_TASKS="WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask";
set TTL_FORBID_DROP_TTL_TBL_WITH_ARC_CCI = false;
drop database if exists alter_ttl_db2;
create database if not exists alter_ttl_db2 mode='auto';
use alter_ttl_db2;
drop table if exists part_with_gsi_t1;
create table part_with_gsi_t1 (
  a int, name varchar(20),
  created_at datetime,
  b int,
  primary key(a))
partition by range columns (created_at) (
  partition p20240401 values less than ('2024-04-01'),
  partition p20240501 values less than ('2024-05-01'),
  partition p20240601 values less than ('2024-06-01')
);
create global index gsi_b on part_with_gsi_t1(b) partition by key(a) partitions 4;
show create table part_with_gsi_t1;
Table,Create Table
part_with_gsi_t1,CREATE TABLE `part_with_gsi_t1` (
	`a` int(11) NOT NULL,
	`name` varchar(20) DEFAULT NULL,
	`created_at` datetime DEFAULT NULL,
	`b` int(11) DEFAULT NULL,
	PRIMARY KEY (`a`),
	GLOBAL INDEX `gsi_b` (`b`) COVERING (`created_at`)
		PARTITION BY KEY(`a`)
		PARTITIONS 4,
	KEY `auto_shard_key_created_at` USING BTREE (`created_at`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
PARTITION BY RANGE COLUMNS(`created_at`)
(PARTITION p20240401 VALUES LESS THAN ('2024-04-01 00:00:00') ENGINE = InnoDB,
 PARTITION p20240501 VALUES LESS THAN ('2024-05-01 00:00:00') ENGINE = InnoDB,
 PARTITION p20240601 VALUES LESS THAN ('2024-06-01 00:00:00') ENGINE = InnoDB)
ALTER TABLE part_with_gsi_t1
MODIFY TTL
SET
TTL_EXPR = created_at EXPIRE AFTER 1 MONTH TIMEZONE '-03:00',
TTL_ENABLE = 'OFF',
TTL_CLEANUP = 'OFF',
TTL_PART_INTERVAL = INTERVAL(1, MONTH),
ARCHIVE_TYPE= 'PARTITION',
ARCHIVE_TABLE_PRE_ALLOCATE=6,
ARCHIVE_TABLE_POST_ALLOCATE=6;
alter table part_with_gsi_t1 cleanup expired data;
show create table part_with_gsi_t1;
