  LogicalView(tables="t1[p1,p2]", shardCount=2, sql="SELECT `a`, `b` FROM `t1` AS `t1`")
explain select * from t1 where a=1;
Logical ExecutionPlan
LogicalView(tables="t1[p1,p2]", shardCount=2, sql="SELECT `a`, `b` FROM `t1` AS `t1` WHERE (`a` = ?)")
explain select * from t1 where a=1 and b=1;
