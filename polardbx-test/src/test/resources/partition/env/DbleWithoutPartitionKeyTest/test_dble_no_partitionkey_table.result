Gather(concurrent=true)
  LogicalView(tables="t1[p1,p2]", shardCount=2, sql="SELECT `a`, `b` FROM `t1` AS `t1` WHERE ((`a` = ?) OR (`b` = ?))")
explain /*TDDL:cmd_extra(IN_SUB_QUERY_THRESHOLD=10000)*/ select * from t1 where a in (1);
Logical ExecutionPlan
Gather(concurrent=true)
  LogicalView(tables="t1[p1,p2]", shardCount=2, sql="SELECT `a`, `b` FROM `t1` AS `t1` WHERE (`a` IN(?))")
