## outer-join/cross-join non-pushdown
explain select t1.id from rep_t8_g1g3g4 t1
left join part_t3_g3g4 t2 on t1.id = t2.id order by t1.id;
Logical ExecutionPlan
Project(id="id")
  BKAJoin(condition="id = id", type="left")
    LogicalView(tables="rep_t8_g1g3g4[p1]", sql="SELECT `id` FROM `rep_t8_g1g3g4` AS `rep_t8_g1g3g4` ORDER BY `id`")
    Gather(concurrent=true)
      LogicalView(tables="part_t3_g3g4[p1,p2]", shardCount=2, sql="SELECT `id` FROM `part_t3_g3g4` AS `part_t3_g3g4` WHERE (`id` IN (...))")
## outer-join/cross-join pushdown with single_group sharding
explain select rt1.id as rt1_id,rt2.id as rt2_id
from rep_t1_g0g1g2 rt1
left join rep_t1_g0g1g2 rt2  on rt2.id=rt1.id
left join part_t1_g0g1g2 pt1 on pt1.id = rt2.id and pt1.id=1
order by rt1_id;
Logical ExecutionPlan
PhyTableOperation(tables="rep_t1_g0g1g2[p1],rep_t1_g0g1g2[p1],part_t1_g0g1g2[p1]", sql="SELECT `rt1`.`id` AS `rt1_id`, `rt2`.`id` AS `rt2_id` FROM ? AS `rt1` LEFT JOIN ? AS `rt2` ON (`rt2`.`id` = `rt1`.`id`) LEFT JOIN ? AS `pt1` ON ((`pt1`.`id` = `rt2`.`id`) AND (`pt1`.`id` = ?)) ORDER BY `rt1_id`", params="1")
explain select rt1.id as rt1_id,rt2.id as rt2_id
from rep_t1_g0g1g2 rt1
left join part_t1_g0g1g2 pt1 on pt1.id = rt1.id and pt1.id=1
left join rep_t1_g0g1g2 rt2 on rt2.id=rt1.id
order by rt1_id;
Logical ExecutionPlan
PhyTableOperation(tables="rep_t1_g0g1g2[p1],part_t1_g0g1g2[p1],rep_t1_g0g1g2[p1]", sql="SELECT `rt1`.`id` AS `rt1_id`, `rt2`.`id` AS `rt2_id` FROM ? AS `rt1` LEFT JOIN ? AS `pt1` ON ((`pt1`.`id` = `rt1`.`id`) AND (`pt1`.`id` = ?)) LEFT JOIN ? AS `rt2` ON (`rt2`.`id` = `rt1`.`id`) ORDER BY `rt1_id`", params="1")
explain select rt1.id as rt1_id,rt2.id as rt2_id
from rep_t1_g0g1g2 rt1
left join part_t1_g0g1g2 pt1 on pt1.id = rt1.id and pt1.id=1
right join rep_t1_g0g1g2 rt2 on rt2.id=rt1.id
order by rt1_id;
Logical ExecutionPlan
PhyTableOperation(tables="rep_t1_g0g1g2[p1],part_t1_g0g1g2[p1],rep_t1_g0g1g2[p1]", sql="SELECT `rt1`.`id` AS `rt1_id`, `rt2`.`id` AS `rt2_id` FROM ? AS `rt1` LEFT JOIN ? AS `pt1` ON ((`pt1`.`id` = `rt1`.`id`) AND (`pt1`.`id` = ?)) RIGHT JOIN ? AS `rt2` ON (`rt2`.`id` = `rt1`.`id`) ORDER BY `rt1_id`", params="1")
explain select rt1.id as rt1_id,rt2.id as rt2_id
from rep_t1_g0g1g2 rt1
left join part_t1_g0g1g2 pt1 on pt1.id = rt1.id and pt1.id in (1,3)
right join rep_t1_g0g1g2 rt2 on rt2.id=rt1.id
order by rt1_id;
Logical ExecutionPlan
SortMergeJoin(condition="id = id", type="right")
  Project(id="id")
    BKAJoin(condition="id = id", type="left")
      LogicalView(tables="rep_t1_g0g1g2[p1]", sql="SELECT `id` FROM `rep_t1_g0g1g2` AS `rep_t1_g0g1g2` ORDER BY `id`")
      Gather(concurrent=true)
        LogicalView(tables="part_t1_g0g1g2[p1,p3]", shardCount=2, sql="SELECT `id` FROM `part_t1_g0g1g2` AS `part_t1_g0g1g2` WHERE ((`id` IN(?)) AND (`id` IN (...)))")
  LogicalView(tables="rep_t1_g0g1g2[p1]", sql="SELECT `id` FROM `rep_t1_g0g1g2` AS `rep_t1_g0g1g2` ORDER BY `id`")
## outer-join/cross-join non-pushdown with multi-group sharding
explain select rt1.id as rt1_id
from rep_t1_g0g1g2 rt1
left join part_t1_g0g1g2 pt1 on pt1.id = rt1.id and pt1.id in (1,3)
order by rt1_id;
Logical ExecutionPlan
Project(rt1_id="id")
  BKAJoin(condition="id = id", type="left")
    LogicalView(tables="rep_t1_g0g1g2[p1]", sql="SELECT `id` FROM `rep_t1_g0g1g2` AS `rep_t1_g0g1g2` ORDER BY `id`")
    Gather(concurrent=true)
      LogicalView(tables="part_t1_g0g1g2[p1,p3]", shardCount=2, sql="SELECT `id` FROM `part_t1_g0g1g2` AS `part_t1_g0g1g2` WHERE ((`id` IN(?)) AND (`id` IN (...)))")
## join non-pushdown because of un-full-cover group key
