Logical ExecutionPlan
PhyTableOperation(tables="rep_t7_g0g3g4[p2],part_t3_g3g4[p1],part_t4_g3g4[p1],rep_t8_g1g3g4[p2]", sql="SELECT `rt7`.`id` AS `id` FROM ? AS `rt7` INNER JOIN ? AS `pt3` ON ((`pt3`.`id` = `rt7`.`id`) AND (`rt7`.`id` = ?)) INNER JOIN ? AS `pt4` ON (`pt4`.`id` = `rt7`.`id`) INNER JOIN ? AS `rt8` ON (`rt8`.`id` = `rt7`.`id`) ORDER BY `rt7`.`id`", params="1")
select rt7.id
from
