## join pushdown1-0: all rep tbl cover all groupKey of all part tbl
explain select rt1.id
from
rep_t1_g0g1g2 rt1
join part_t1_g0g1g2 pt1 on pt1.id = rt1.id
join part_t2_g0g1g2 pt2 on pt2.id = rt1.id
order by rt1.id;
Logical ExecutionPlan
MergeSort(sort="id ASC")
  LogicalView(tables="part_t1_g0g1g2[p1,p2,p3],part_t2_g0g1g2[p1,p2,p3],rep_t1_g0g1g2", shardCount=3, sql="SELECT `rep_t1_g0g1g2`.`id` FROM `part_t1_g0g1g2` AS `part_t1_g0g1g2` INNER JOIN `part_t2_g0g1g2` AS `part_t2_g0g1g2` ON (`part_t1_g0g1g2`.`id` = `part_t2_g0g1g2`.`id`) INNER JOIN `rep_t1_g0g1g2` AS `rep_t1_g0g1g2` ON ((`part_t1_g0g1g2`.`id` = `rep_t1_g0g1g2`.`id`) AND (`part_t2_g0g1g2`.`id` = `rep_t1_g0g1g2`.`id`)) ORDER BY `rep_t1_g0g1g2`.`id`")
explain select rt1.id
from
rep_t1_g0g1g2 rt1
join part_t1_g0g1g2 pt1 on pt1.id = rt1.id
join part_t2_g0g1g2 pt2 on pt2.id = rt1.id
join rep_t2_g0g1g2 rt2 on rt2.id = rt1.id
order by rt1.id;
Logical ExecutionPlan
MergeSort(sort="id ASC")
  LogicalView(tables="rep_t1_g0g1g2,rep_t2_g0g1g2,part_t1_g0g1g2[p1,p2,p3],part_t2_g0g1g2[p1,p2,p3]", shardCount=3, sql="SELECT `rep_t1_g0g1g2`.`id` FROM `rep_t1_g0g1g2` AS `rep_t1_g0g1g2` INNER JOIN `rep_t2_g0g1g2` AS `rep_t2_g0g1g2` ON (`rep_t1_g0g1g2`.`id` = `rep_t2_g0g1g2`.`id`) INNER JOIN (`part_t1_g0g1g2` AS `part_t1_g0g1g2` INNER JOIN `part_t2_g0g1g2` AS `part_t2_g0g1g2` ON (`part_t1_g0g1g2`.`id` = `part_t2_g0g1g2`.`id`)) ON ((`rep_t1_g0g1g2`.`id` = `part_t1_g0g1g2`.`id`) AND (`rep_t1_g0g1g2`.`id` = `part_t2_g0g1g2`.`id`) AND (`rep_t2_g0g1g2`.`id` = `part_t1_g0g1g2`.`id`) AND (`rep_t2_g0g1g2`.`id` = `part_t2_g0g1g2`.`id`)) ORDER BY `rep_t1_g0g1g2`.`id`")
explain select rt1.id
from
rep_t1_g0g1g2 rt1
join part_t1_g0g1g2 pt1 on pt1.id = rt1.id
join part_t2_g0g1g2 pt2 on pt2.id = rt1.id
join rep_t2_g0g1g2 rt2 on rt2.id = rt1.id
order by rt1.id;
Logical ExecutionPlan
MergeSort(sort="id ASC")
  LogicalView(tables="rep_t1_g0g1g2,rep_t2_g0g1g2,part_t1_g0g1g2[p1,p2,p3],part_t2_g0g1g2[p1,p2,p3]", shardCount=3, sql="SELECT `rep_t1_g0g1g2`.`id` FROM `rep_t1_g0g1g2` AS `rep_t1_g0g1g2` INNER JOIN `rep_t2_g0g1g2` AS `rep_t2_g0g1g2` ON (`rep_t1_g0g1g2`.`id` = `rep_t2_g0g1g2`.`id`) INNER JOIN (`part_t1_g0g1g2` AS `part_t1_g0g1g2` INNER JOIN `part_t2_g0g1g2` AS `part_t2_g0g1g2` ON (`part_t1_g0g1g2`.`id` = `part_t2_g0g1g2`.`id`)) ON ((`rep_t1_g0g1g2`.`id` = `part_t1_g0g1g2`.`id`) AND (`rep_t1_g0g1g2`.`id` = `part_t2_g0g1g2`.`id`) AND (`rep_t2_g0g1g2`.`id` = `part_t1_g0g1g2`.`id`) AND (`rep_t2_g0g1g2`.`id` = `part_t2_g0g1g2`.`id`)) ORDER BY `rep_t1_g0g1g2`.`id`")
select rt1.id
from
