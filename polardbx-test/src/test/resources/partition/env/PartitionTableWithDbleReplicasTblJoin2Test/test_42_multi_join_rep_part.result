## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
## LOCALITY_DN_LIST: $dn1, $dn2;
set ENABLE_PUSH_DOWN_AUTO_INCREMENT=true;
set DEFAULT_COLLATION_FOR_UTF8MB4='utf8mb4_bin';
set COLLATION_SERVER='utf8mb4_bin';
set ENABLE_POST_PLANNER_PARTITION_HINT_PRUNING=true;
set ENABLE_REPLICAS_RANDOM_READ= false;
use polardbx;
drop database if exists repjoin42_db;
## USE_DN_LIST_MSG
create database if not exists `repjoin42_db` CHARSET = `utf8mb4` COLLATE = `utf8mb4_general_ci` MODE = 'auto'
LOCALITY = 'dble_config={"group_config":{
  "repjoin42_db_g0":["$dn1","repjoin42_db_g0"],
  "repjoin42_db_g1":["$dn2","repjoin42_db_g1"],
  "repjoin42_db_g2":["$dn1","repjoin42_db_g2"],
  "repjoin42_db_g3":["$dn2","repjoin42_db_g3"],
  "repjoin42_db_g4":["$dn1","repjoin42_db_g4"],
  "repjoin42_db_g5":["$dn2","repjoin42_db_g5"]
}}';
use repjoin42_db;
DROP TABLE IF EXISTS `rep_t1_g0g1g2`;
CREATE TABLE IF NOT EXISTS `rep_t1_g0g1g2` (
  `id` bigint(20) NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
REPLICAS
LOCALITY='db_set=repjoin42_db_g0,repjoin42_db_g1,repjoin42_db_g2';
