explain select rt8.id
from
rep_t8_g1g3g4 rt8
join part_t3_g3g4 pt3 on pt3.id = rt8.id
join part_t4_g3g4 pt4 on pt4.id = rt8.id
join rep_t6_g5 rt6 on rt6.id = pt4.id
order by rt8.id;
Logical ExecutionPlan
Project(id="id")
  HashJoin(condition="id = id0 AND id = id00 AND id = id", type="inner")
    MergeSort(sort="id ASC")
      LogicalView(tables="rep_t8_g1g3g4,part_t3_g3g4[p1,p2],part_t4_g3g4[p1,p2]", shardCount=2, sql="SELECT `rep_t8_g1g3g4`.`id`, `part_t3_g3g4`.`id` AS `id0`, `part_t4_g3g4`.`id` AS `id1` FROM `rep_t8_g1g3g4` AS `rep_t8_g1g3g4` INNER JOIN (`part_t3_g3g4` AS `part_t3_g3g4` INNER JOIN `part_t4_g3g4` AS `part_t4_g3g4` ON (`part_t3_g3g4`.`id` = `part_t4_g3g4`.`id`)) ON ((`rep_t8_g1g3g4`.`id` = `part_t3_g3g4`.`id`) AND (`rep_t8_g1g3g4`.`id` = `part_t4_g3g4`.`id`)) WHERE (`part_t3_g3g4`.`id` = `part_t4_g3g4`.`id`) ORDER BY `rep_t8_g1g3g4`.`id`")
    LogicalView(tables="rep_t6_g5[p1]", sql="SELECT `id` FROM `rep_t6_g5` AS `rep_t6_g5`")
select rt8.id
from
rep_t8_g1g3g4 rt8
