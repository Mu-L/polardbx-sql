##==== insert & select ====
insert into r_dml_g1g2_t1 values (null,10),(null,20);
select * from r_dml_g1g2_t1 order by b desc;
a,b
2,20
1,10
set PARTITION_HINT='p1';
select * from r_dml_g1g2_t1 order by b desc;
a,b
2,20
1,10
set PARTITION_HINT='p2';
select * from r_dml_g1g2_t1 order by b desc;
a,b
2,20
1,10
set PARTITION_HINT='';
insert into part_dml_g1g2_t1 values (null,10),(null,20);
select * from part_dml_g1g2_t1 partition (p1) order by b desc;
a,b
2,20
1,10
select * from part_dml_g1g2_t1 partition (p2) order by b desc;
a,b
select t1.b from part_dml_g1g2_t1 partition (p2) as t1 inner join r_dml_g1g2_t1 t2 on t1.a=t2.a order by t1.b desc;
b
select t1.b from part_dml_g1g2_t1 partition (p1) as t1 inner join r_dml_g1g2_t1 t2 on t1.a=t2.a order by t1.b desc;
b
20
10
select t1.b from part_dml_g1g2_t1 as t1 inner join r_dml_g1g2_t1 t2 on t1.a=t2.a order by t1.b desc;
b
20
10
explain insert into r_dml_g1g2_t2 select * from r_dml_g1g2_t1;
Logical ExecutionPlan
LogicalInsert(table="r_dml_g1g2_t2", columns=RecordType(INTEGER a, INTEGER b), mode=SINGLE)
  LogicalView(tables="r_dml_g1g2_t1[p1]", sql="SELECT `a`, `b` FROM `r_dml_g1g2_t1` AS `r_dml_g1g2_t1`")
insert into r_dml_g1g2_t2 select * from r_dml_g1g2_t1;
select t1.b from part_dml_g1g2_t1 as t1 inner join r_dml_g1g2_t2 t2 on t1.a=t2.a order by t1.b desc;
b
20
10
explain insert into r_dml_g2g3_t1 select * from r_dml_g1g2_t1;
Logical ExecutionPlan
LogicalInsert(table="r_dml_g2g3_t1", columns=RecordType(INTEGER a, INTEGER b), mode=SINGLE)
  LogicalView(tables="r_dml_g1g2_t1[p1]", sql="SELECT `a`, `b` FROM `r_dml_g1g2_t1` AS `r_dml_g1g2_t1`")
insert into r_dml_g2g3_t1 select * from r_dml_g1g2_t1;
select t1.b from part_dml_g1g2_t1 as t1 inner join r_dml_g2g3_t1 t2 on t1.a=t2.a order by t1.b desc;
