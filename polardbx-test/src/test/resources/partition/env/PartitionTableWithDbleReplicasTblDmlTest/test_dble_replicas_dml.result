##==== update/delete ====
update r_dml_g2g3_t1 set b=30 where a=1;
select t2.a,t2.b from part_dml_g1g2_t1 as t1 inner join r_dml_g2g3_t1 t2 on t1.a=t2.a order by t1.b desc;
a,b
2,20
##==== alter ddl ====
alter table r_dml_g2g3_t1 add column c int;
alter table r_dml_g2g3_t1 modify column c bigint;
create index idx_c on r_dml_g2g3_t1(c);
show create table r_dml_g2g3_t1;
Table,Create Table
r_dml_g2g3_t1,CREATE TABLE `r_dml_g2g3_t1` (
	`a` int(11) NOT NULL AUTO_INCREMENT,
	`b` int(11) DEFAULT NULL,
	`c` bigint(20) DEFAULT NULL,
	PRIMARY KEY (`a`),
	KEY `idx_c` (`c`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8
