## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
## LOCALITY_DN_LIST: $dn1, $dn2;
## test dble_db
set ENABLE_PUSH_DOWN_AUTO_INCREMENT=true;
set DEFAULT_COLLATION_FOR_UTF8MB4='utf8mb4_bin';
set COLLATION_SERVER='utf8mb4_bin';
set ENABLE_POST_PLANNER_PARTITION_HINT_PRUNING=true;
set ENABLE_RANDOM_PHY_TABLE_NAME=false;
set ENABLE_REPLICAS_RANDOM_READ= false;
set GROUP_PARALLELISM=1;
use polardbx;
drop database if exists mydbledb4;
## USE_DN_LIST_MSG
create database if not exists mydbledb4 mode = 'auto'
locality='dble_config={"group_config":{"mydbledb4_g1":["$dn1","mydbledb4_01"],"mydbledb4_g2":["$dn2","mydbledb4_02"],"mydbledb4_g3":["$dn1","mydbledb4_03"],"mydbledb4_g4":["$dn2","mydbledb4_04"], "mydbledb4_g5":["$dn1","mydbledb4_05"], "mydbledb4_g6":["$dn2","mydbledb4_06"] }}';
use mydbledb4;
