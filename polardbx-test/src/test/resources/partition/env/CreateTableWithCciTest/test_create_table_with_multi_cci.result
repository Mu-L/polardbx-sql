	PRIMARY KEY (`r_regionkey`),
	CLUSTERED COLUMNAR INDEX `region_col_index`(`r_regionkey`) PARTITION BY HASH (`r_regionkey`) PARTITIONS 1 DICTIONARY_COLUMNS = 'r_name',
	CLUSTERED COLUMNAR INDEX `region_name_index`(`r_name`) PARTITION BY HASH (`r_regionkey`) PARTITIONS 1
) ENGINE = InnoDB DEFAULT CHARSET = latin1
PARTITION BY KEY (`r_regionkey`) PARTITIONS 3
