# create table with two CCIs specifying dictionary_columns
/*+TDDL:CMD_EXTRA(SKIP_DDL_TASKS="WaitColumnarTableCreationTask")*/CREATE TABLE `region` (
	`r_regionkey` int(11) NOT NULL,
