## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
## test_ttl_rebuild_auto_decide_policy
## Verify auto decision logic: when expired data percent and row count exceed thresholds, auto trigger rebuild
set TTL_DEBUG_USE_GSI_FOR_COLUMNAR_ARC_TBL = false;
set TTL_DEBUG_CCI_SKIP_DDL_TASKS = "WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask";
set SKIP_DDL_TASKS="WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask";
set sql_mode='';
set TTL_ADD_MAXVAL_PART_ON_CCI_CREATING=true;
set TTL_FORBID_DROP_TTL_TBL_WITH_ARC_CCI = false;
CREATE TABLE `ttl_rb2` (
  `a` bigint(20) NOT NULL AUTO_INCREMENT,
  `b` datetime DEFAULT NULL,
  PRIMARY KEY(a)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
TTL = TTL_DEFINITION (
  TTL_ENABLE = 'OFF',
  TTL_EXPR = `b` EXPIRE AFTER 1 month TIMEZONE '+08:00',
  TTL_JOB = CRON '0 0 2 * * ? *',
  TTL_CLEANUP = 'ON',
  ARCHIVE_TYPE = 'ROW',
  ARCHIVE_TABLE_NAME = '',
  ARCHIVE_TABLE_PRE_ALLOCATE = 12,
  ARCHIVE_TABLE_POST_ALLOCATE = 12
)
PARTITION BY KEY(`a`)
PARTITIONS 2;
