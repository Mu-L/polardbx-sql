## DISABLE_FAST_SQL_PARSER
select unitmurhashc2('2')
unitmurhashc2('2')
0
## error_msg: $# too long #$
select unitmurhashc2('123456789012345678901')
too long
## error_msg: $# not digit #$
select unitmurhashc2('aaa')
not digit
create table dble_t2
(a varchar(64), b int)
partition by udf_hash(unitmurhashc2(a))
partitions 2
(
partition p1 values less than(1),
partition p2 values less than(2)
)
insert into dble_t2 values ('2', 2)
select * from dble_t2 where a='2'
a,b
2,2
select part_route('','dble_t2', '2')
part_route('', 'dble_t2', '2')
p1
## error_msg: $# check routeKey is legal #$
select part_route('','dble_t2', '')
check routeKey is legal
## error_msg: $# check routeKey is legal #$
select part_route('','dble_t2', '123456789012345678901')
check routeKey is legal
## error_msg: $# check routeKey is legal #$
select part_route('','dble_t2', 'aaa')
check routeKey is legal
drop table dble_t2;