## DISABLE_FAST_SQL_PARSER
## normal
select unitmurhashc11('5')
unitmurhashc11('5')
0
## error_msg: $# routeKey is legal #$
select unitmurhashc11('')
routeKey is legal
## error_msg: $# routeKey is legal #$
select unitmurhashc11('1234567891234567891234567')
routeKey is legal
## error_msg: $# routeKey is legal #$
select unitmurhashc11('a')
routeKey is legal
create table dble_t11
(a varchar(64), b int)
partition by udf_hash(unitmurhashc11(a))
partitions 2
(
partition p1 values less than(1),
partition p2 values less than(2)
)
insert into dble_t11 values ('2', 2)
select * from dble_t11 where a='2'
a,b
2,2
select part_route('','dble_t11', '2')
part_route('', 'dble_t11', '2')
p2
## error_msg: $# routeKey is legal #$
select part_route('','dble_t11', '')
routeKey is legal
## error_msg: $# routeKey is legal #$
select part_route('','dble_t11', '1234567891234567891234567')
routeKey is legal
## error_msg: $# routeKey is legal #$
select part_route('','dble_t11', 'aaa')
routeKey is legal
drop table dble_t11;