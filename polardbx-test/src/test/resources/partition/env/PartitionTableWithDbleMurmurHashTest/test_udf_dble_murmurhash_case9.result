## DISABLE_FAST_SQL_PARSER
## normal
select unitmurhashc9('5')
unitmurhashc9('5')
1
## error_msg: $# routeKey is legal #$
select unitmurhashc9('')
routeKey is legal
## error_msg: $# routeKey is legal #$
select unitmurhashc9('1234567891234567891234567')
routeKey is legal
## error_msg: $# routeKey is legal #$
select unitmurhashc9('a')
routeKey is legal
create table dble_t9
(a varchar(64), b int)
partition by udf_hash(unitmurhashc9(a))
partitions 2
(
partition p1 values less than(1),
partition p2 values less than(2)
)
insert into dble_t9 values ('2', 2)
select * from dble_t9 where a='2'
a,b
2,2
select part_route('','dble_t9', '2')
part_route('', 'dble_t9', '2')
p1
## error_msg: $# routeKey is legal #$
select part_route('','dble_t9', '')
routeKey is legal
## error_msg: $# routeKey is legal #$
select part_route('','dble_t9', '1234567891234567891234567')
routeKey is legal
## error_msg: $# routeKey is legal #$
select part_route('','dble_t9', 'aaa')
routeKey is legal
drop table dble_t9;