## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
## LOCALITY_DN_LIST: $dn1, $dn2;
set ROUTE_TUPLE_USE_PRECHECK_BY_UDF_FUNC=true;
set ROUTE_TUPLE_IGNORE_BAD_VALUE_TYPE_CAST=true;
set ENABLE_PUSH_DOWN_AUTO_INCREMENT=true;
create table dblemurhash_13 (
  id varchar(32) not null primary key,
  name varchar(20)
  )
  partition by UDF_HASH(
  `id` with udf_params(
  'dble/unitmurmurhash',
  '{
"partitionCount" : "2",
"shardingValueMaxLength" : "20"
}'
  )
)
partitions 2;
insert into dblemurhash_13(id,name) values('8','a');
select * from dblemurhash_13 where id = '8';
id,name
8,a
## error_msg: $# routeField is null or "" ! #$
insert into dblemurhash_13(id,name) values('','a');
routeField is null or "" !
## error_msg: $# routeField is null or "" ! #$
insert into dblemurhash_13(id,name) values(null,'a');
routeField is null or "" !
## error_msg: $# routeField is too long, over 20  #$
insert into dblemurhash_13(id,name) values('123456789123456789123456712345', 'a');
routeField is too long, over 20
## error_msg: $# routeField is not digit ! #$
insert into dblemurhash_13(id,name) values('a', 'a');
routeField is not digit !
