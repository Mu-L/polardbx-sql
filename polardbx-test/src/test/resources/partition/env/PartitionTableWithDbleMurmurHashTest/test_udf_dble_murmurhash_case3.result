## DISABLE_FAST_SQL_PARSER
select unitmurhashc3('2')
unitmurhashc3('2')
0
## error_msg: $# too long #$
select unitmurhashc3('123456789012345678901')
too long
## error_msg: $# not digit #$
select unitmurhashc3('aaa')
not digit
create table dble_t3
(a varchar(64), b int)
partition by udf_hash(unitmurhashc3(a))
partitions 2
(
partition p1 values less than(1),
partition p2 values less than(2)
)
insert into dble_t3 values ('2', 2)
select * from dble_t3 where a='2'
a,b
2,2
select part_route('','dble_t3', '2')
part_route('', 'dble_t3', '2')
p1
## error_msg: $# check routeKey is legal #$
select part_route('','dble_t3', '')
check routeKey is legal
## error_msg: $# check routeKey is legal #$
select part_route('','dble_t3', '123456789012345678901')
check routeKey is legal
## error_msg: $# check routeKey is legal #$
select part_route('','dble_t3', 'aaa')
check routeKey is legal
drop table dble_t3;