## create table ttl_rng_t1
drop table if exists ttl_rng_t1
create table ttl_rng_t1(
a int not null auto_increment,
b datetime,
primary key(a)
)
partition by range columns(b)
(
  partition p1 values less than('2024-06-24'),
  partition p2 values less than('2024-06-25'),
  partition p3 values less than('2024-06-26'),
  partition p4 values less than('2024-06-27'),
  partition p5 values less than('2024-06-28'),
  partition p6 values less than('2024-06-29'),
  partition p7 values less than('2024-06-30')
)
alter table ttl_rng_t1
modify ttl
ttl_enable = 'on',
ttl_cleanup = 'on',
ttl_expr = `b` expire after 1 day timezone '+08:00',
ttl_job = cron '0 0 0 1 1 ? */1' timezone '+08:00',
ttl_part_interval=interval(1,day),
archive_type='partition',
archive_table_pre_allocate=2,
archive_table_post_allocate=4
show create table ttl_rng_t1
Table,Create Table
ttl_rng_t1,CREATE TABLE `ttl_rng_t1` (
	`a` int(11) NOT NULL AUTO_INCREMENT,
	`b` datetime DEFAULT NULL,
	PRIMARY KEY (`a`),
	KEY `auto_shard_key_b` USING BTREE (`b`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 TTL = TTL_DEFINITION ( TTL_ENABLE = 'ON', TTL_EXPR = `b` EXPIRE AFTER 1 day TIMEZONE '+08:00', TTL_JOB = CRON '0 0 0 1 1 ? */1', TTL_CLEANUP = 'ON', TTL_PART_INTERVAL = INTERVAL(1, DAY), ARCHIVE_TYPE = 'PARTITION', ARCHIVE_TABLE_NAME = '', ARCHIVE_TABLE_PRE_ALLOCATE = 2, ARCHIVE_TABLE_POST_ALLOCATE = 4 )
PARTITION BY RANGE COLUMNS(`b`)
(PARTITION p1 VALUES LESS THAN ('2024-06-24 00:00:00') ENGINE = InnoDB,
 PARTITION p2 VALUES LESS THAN ('2024-06-25 00:00:00') ENGINE = InnoDB,
 PARTITION p3 VALUES LESS THAN ('2024-06-26 00:00:00') ENGINE = InnoDB,
 PARTITION p4 VALUES LESS THAN ('2024-06-27 00:00:00') ENGINE = InnoDB,
 PARTITION p5 VALUES LESS THAN ('2024-06-28 00:00:00') ENGINE = InnoDB,
 PARTITION p6 VALUES LESS THAN ('2024-06-29 00:00:00') ENGINE = InnoDB,
 PARTITION p7 VALUES LESS THAN ('2024-06-30 00:00:00') ENGINE = InnoDB)
