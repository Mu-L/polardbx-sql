set TTL_DEBUG_USE_GSI_FOR_COLUMNAR_ARC_TBL = false
set TTL_DEBUG_CCI_SKIP_DDL_TASKS = "WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask"
set TTL_DEBUG_CURRENT_DATETIME='2024-06-27 00:00:00'
set SKIP_DDL_TASKS="WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask"
set TTL_FORBID_DROP_TTL_TBL_WITH_ARC_CCI = false
use polardbx
drop database if exists test_arc_row_part_split_db
create database if not exists test_arc_row_part_split_db mode='auto'
use test_arc_row_part_split_db
## create table ttl_row_t1
drop table if exists ttl_row_t1
create table ttl_row_t1(
a int not null auto_increment,
b datetime,
primary key(a)
)
partition by key(a)
partitions 8
alter table ttl_row_t1
modify ttl
ttl_enable = 'on',
ttl_cleanup = 'on',
ttl_expr = `b` expire after 1 day timezone '+08:00',
ttl_job = cron '0 0 0 1 1 ? */1' timezone '+08:00',
ttl_part_interval=interval(1,day),
archive_type='row',
archive_table_pre_allocate=2,
archive_table_post_allocate=4
show create table ttl_row_t1
Table,Create Table
ttl_row_t1,CREATE TABLE `ttl_row_t1` (
	`a` int(11) NOT NULL AUTO_INCREMENT,
	`b` datetime DEFAULT NULL,
	PRIMARY KEY (`a`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 TTL = TTL_DEFINITION ( TTL_ENABLE = 'ON', TTL_EXPR = `b` EXPIRE AFTER 1 day TIMEZONE '+08:00', TTL_JOB = CRON '0 0 0 1 1 ? */1', TTL_CLEANUP = 'ON', TTL_PART_INTERVAL = INTERVAL(1, DAY), ARCHIVE_TYPE = 'ROW', ARCHIVE_TABLE_NAME = '', ARCHIVE_TABLE_PRE_ALLOCATE = 2, ARCHIVE_TABLE_POST_ALLOCATE = 4 )
PARTITION BY KEY(`a`)
PARTITIONS 8
