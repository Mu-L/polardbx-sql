## create table
drop table if exists test_multi_arc_tbl_db2_tmp1.ttl_rng_t1
create table test_multi_arc_tbl_db2_tmp1.ttl_rng_t1(
a int not null auto_increment,
b datetime,
primary key(a)
)
partition by range columns(`b`)
(
partition p0 values less than ('1970-01-01'),
partition p1 values less than ('1970-02-01'),
partition p2 values less than ('1970-03-01')
)
alter table test_multi_arc_tbl_db2_tmp1.ttl_rng_t1
modify ttl
ttl_enable = 'on',
ttl_cleanup = 'on',
ttl_expr = `b` expire after 1 day timezone '+08:00',
ttl_job = cron '0 0 0 1 1 ? */1' timezone '+08:00',
ttl_part_interval=interval(1,day),
archive_type='partition',
archive_table_pre_allocate=2,
archive_table_post_allocate=4
