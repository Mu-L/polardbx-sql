## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
drop table if exists dblemur_t3;
create table dblemur_t3
  (a varchar(64)，b bigint)
  partition by udf_hash(
  `a` with udf_params (
    'dble/unitmurmurhash',
    '{
      "partitionCount": "2",
      "isDigitCheck": "1",
      "leftPaddingChar": "A",
      "shardingValueMaxLength": "20"
    }'
  )
  )
 partitions 2;
insert into dblemur_t3 values ('2', 2);
select * from dblemur_t3 where a='2';
a,b
2,2
select part_route('','dblemur_t3', '2');
part_route('', 'dblemur_t3', '2')
p1
## error_msg: $# check routeKey is legal #$
select part_route('','dblemur_t3', '');
check routeKey is legal
## error_msg: $# check routeKey is legal #$
select part_route('','dblemur_t3', '123456789012345678901');
check routeKey is legal
## error_msg: $# check routeKey is legal #$
select part_route('','dblemur_t3', null);
check routeKey is legal
drop table dblemur_t3;