## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
drop table if exists dblemur_t4;
create table dblemur_t4
  (a varchar(64)，b bigint)
  partition by udf_hash(
  `a` with udf_params (
  'dble/unitmurmurhash',
  '{"partitionCount": "2","isDigitCheck": "0","leftPaddingChar": "NO","shardingValueMaxLength": "20"}'
  )
  )
 partitions 2;
insert into dblemur_t4 values ('2', 2);
select * from dblemur_t4 where a='2';
a,b
2,2
select part_route('','dblemur_t4', '2');
part_route('', 'dblemur_t4', '2')
p1
## error_msg: $# check routeKey is legal #$
select part_route('','dblemur_t4', '');
check routeKey is legal
## error_msg: $# check routeKey is legal #$
  select part_route('','dblemur_t4', null);
check routeKey is legal
select part_route('','dblemur_t4', '123456789012345678901');
part_route('', 'dblemur_t4', '123456789012345678901')
p2
select part_route('','dblemur_t4', 'aaa');
part_route('', 'dblemur_t4', 'aaa')
p2
drop table dblemur_t4;