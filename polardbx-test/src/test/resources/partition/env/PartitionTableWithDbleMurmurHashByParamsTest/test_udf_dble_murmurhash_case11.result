## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
  drop table if exists dblemur_t11;
create table dblemur_t11
  (a varchar(64)，b bigint)
  partition by udf_hash(
  `a` with udf_params (
  'dble/unitmurmurhash',
  '{"partitionCount": "2","isDigitCheck": "1","leftPaddingChar": "NO"}'
  )
  )
 partitions 2;
insert into dblemur_t11 values ('2', 2);
select * from dblemur_t11 where a='2';
a,b
2,2
select part_route('','dblemur_t11', '2');
part_route('', 'dblemur_t11', '2')
p2
## error_msg: $# routeKey is legal #$
select part_route('','dblemur_t11', '');
routeKey is legal
## error_msg: $# routeKey is legal #$
select part_route('','dblemur_t11', '1234567891234567891234567');
routeKey is legal
## error_msg: $# routeKey is legal #$
select part_route('','dblemur_t11', 'aaa');
routeKey is legal
drop table dblemur_t11;