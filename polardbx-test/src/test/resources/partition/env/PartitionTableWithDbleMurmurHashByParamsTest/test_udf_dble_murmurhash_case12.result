## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
  drop table if exists dblemur_t12;
create table dblemur_t12
  (a varchar(64)，b bigint)
  partition by udf_hash(
  `a` with udf_params (
  'dble/unitmurmurhash',
  '{"partitionCount": "2","isDigitCheck": "1","leftPaddingChar": "A"}'
  )
  )
partitions 2;
insert into dblemur_t12 values ('2', 2);
## error_msg: $# routeKey is legal #$
insert into dblemur_t12 values (null, 3);
routeKey is legal
select * from dblemur_t12 where a='2';
a,b
2,2
select part_route('','dblemur_t12', '2');
part_route('', 'dblemur_t12', '2')
p2
## error_msg: $# routeKey is legal #$
select part_route('','dblemur_t12', '');
routeKey is legal
## error_msg: $# routeKey is legal #$
select part_route('','dblemur_t12', null);
routeKey is legal
## error_msg: $# routeKey is legal #$
select part_route('','dblemur_t12', '1234567891234567891234567');
routeKey is legal
## error_msg: $# routeKey is legal #$
select part_route('','dblemur_t12', 'aaa');
routeKey is legal
drop table dblemur_t12;