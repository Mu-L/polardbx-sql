alter table t3_without_arc
modify ttl
set
ttl_enable = 'on',
ttl_expr = `b` expire after 2 month timezone '+08:00',
ttl_job = cron '0 0 1 */2 * ? *' timezone '+08:00',
archive_table_pre_allocate = 2,
archive_table_post_allocate = 2;
alter table t4_without_arc
modify ttl
set
ttl_enable = 'on',
ttl_expr = `b` expire after 2 month timezone '+08:00',
ttl_job = cron '0 0 1 */2 * ? *' timezone '+08:00',
archive_table_pre_allocate = 2,
archive_table_post_allocate = 2;
##
## t1_with_arc->t2_with_arc
## t2_with_arc->t1_with_arc
##
rename table
t1_with_arc to tmp1,
t2_with_arc to t1_with_arc,
tmp1 to t2_with_arc;
##
## t3_without_arc->t4_without_arc
## t4_without_arc->t3_without_arc
##
rename table
t3_without_arc to tmp2,
t4_without_arc to t3_without_arc,
tmp2 to t4_without_arc;
##
## t5_normal->t6_normal
## t6_normal->t5_normal
##
rename table
t5_normal to tmp3,
t6_normal to t5_normal,
tmp3 to t6_normal;
show create table t1_with_arc;
