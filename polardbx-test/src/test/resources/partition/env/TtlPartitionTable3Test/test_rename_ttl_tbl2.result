## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
set TTL_DEBUG_USE_GSI_FOR_COLUMNAR_ARC_TBL = false;
set TTL_DEBUG_CCI_SKIP_DDL_TASKS = "WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask";
set SKIP_DDL_TASKS="WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask";
set TTL_DEBUG_CURRENT_DATETIME='2024-06-27 00:00:00';
set TTL_FORBID_DROP_TTL_TBL_WITH_ARC_CCI=false;
drop database if exists test_rename_ttl_db;
create database if not exists test_rename_ttl_db mode='auto';
use test_rename_ttl_db;
create table ttl_with_arc_t1(
a int not null auto_increment,
b datetime default current_timestamp,
primary key(a)
)
partition by key(a)
partitions 2;
create table ttl_without_arc_t1(
a int not null auto_increment,
b datetime default current_timestamp,
primary key(a)
)
partition by key(a)
partitions 2;
alter table ttl_with_arc_t1
modify ttl
set
ttl_enable = 'on',
ttl_expr = `b` expire after 2 month timezone '+08:00',
ttl_job = cron '0 0 1 */2 * ? *' timezone '+08:00',
archive_table_pre_allocate = 2,
archive_table_post_allocate = 2;
alter table ttl_without_arc_t1
modify ttl
set
ttl_enable = 'on',
ttl_expr = `b` expire after 2 month timezone '+08:00',
ttl_job = cron '0 0 1 */2 * ? *' timezone '+08:00',
archive_table_pre_allocate = 2,
archive_table_post_allocate = 2;
create table ttl_with_arc_t1_arc like ttl_with_arc_t1 engine='columnar' archive_mode='ttl';
alter table ttl_with_arc_t1 cleanup expired data;
show create table ttl_with_arc_t1;
