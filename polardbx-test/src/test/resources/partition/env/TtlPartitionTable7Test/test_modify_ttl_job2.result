## DISABLE_FAST_SQL_PARSER
set TTL_DEBUG_USE_GSI_FOR_COLUMNAR_ARC_TBL = false
set TTL_DEBUG_CCI_SKIP_DDL_TASKS = "WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask"
set TTL_DEBUG_CURRENT_DATETIME='2024-06-27 00:00:00'
set SKIP_DDL_TASKS="WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask"
set TTL_FORBID_DROP_TTL_TBL_WITH_ARC_CCI = false
use polardbx
drop database if exists newttldb1
create database if not exists newttldb1 mode='auto'
use newttldb1
## create table
drop table if exists test_ttl_job2
create table test_ttl_job2(
a int not null auto_increment,
b datetime,
primary key(a)
)
partition by key(`a`)
partitions 16
insert into test_ttl_job2(a,b) values (null, '1970-02-01')
insert into test_ttl_job2 select null,b from test_ttl_job2
insert into test_ttl_job2 select null,b from test_ttl_job2
select count(1) from test_ttl_job2
count(1)
4
alter table test_ttl_job2
modify ttl
ttl_enable = 'on',
ttl_cleanup = 'on',
ttl_expr = `b` expire after 1 day timezone '+08:00',
ttl_job = cron '0 */1 * * * ? *' timezone '+08:00'
show create table test_ttl_job2
Table,Create Table
test_ttl_job2,CREATE TABLE `test_ttl_job2` (
	`a` int(11) NOT NULL AUTO_INCREMENT,
	`b` datetime DEFAULT NULL,
	PRIMARY KEY (`a`)
) ENGINE = InnoDB AUTO_INCREMENT = 5 DEFAULT CHARSET = utf8mb4 TTL = TTL_DEFINITION ( TTL_ENABLE = 'ON', TTL_EXPR = `b` EXPIRE AFTER 1 day TIMEZONE '+08:00', TTL_JOB = CRON '0 */1 * * * ? *', TTL_CLEANUP = 'ON', TTL_PART_INTERVAL = INTERVAL(1, DAY), ARCHIVE_TYPE = 'ROW', ARCHIVE_TABLE_NAME = '', ARCHIVE_TABLE_PRE_ALLOCATE = 12, ARCHIVE_TABLE_POST_ALLOCATE = 64 )
PARTITION BY KEY(`a`)
PARTITIONS 16
select sleep(120)
sleep(120)
0
select count(1) > 0 from metadb.scheduled_jobs where table_schema='newttldb1' and table_name='test_ttl_job2'
count(1) > 0
1
select count(1) > 0 from metadb.fired_scheduled_jobs where table_schema='newttldb1' and table_name='test_ttl_job2' and state in ('QUEUED','SUCCESS') and fire_time > 0
count(1) > 0
1
drop database if exists newttldb1
use polardbx;