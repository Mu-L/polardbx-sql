## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
set TTL_DEBUG_USE_GSI_FOR_COLUMNAR_ARC_TBL = false;
set TTL_DEBUG_CCI_SKIP_DDL_TASKS = "WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask";
set TTL_DEBUG_CURRENT_DATETIME='2024-06-27 00:00:00';
set SKIP_DDL_TASKS="WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask";
set TTL_FORBID_DROP_TTL_TBL_WITH_ARC_CCI = false;
use polardbx;
drop database if exists newttldb7_4;
create database if not exists newttldb7_4 mode='auto';
use newttldb7_4;
drop table if exists arc_date_by_year;
create table if not exists arc_date_by_year(
a int not null auto_increment,
b date,
primary key(a)
)
partition by range columns(`b`)
(
partition p1 values less than ('2025-01-01'),
partition p2 values less than ('2026-01-01'),
partition p3 values less than ('2027-01-01')
);
alter table arc_date_by_year
modify ttl
ttl_enable = 'off',
ttl_cleanup = 'on',
ttl_expr = `b` expire after 1 year timezone '+08:00',
ttl_part_interval = interval(1, year),
archive_type = 'partition',
archive_table_pre_allocate = 4
archive_table_post_allocate = 2;
show create table arc_date_by_year;
Table,Create Table
arc_date_by_year,CREATE TABLE `arc_date_by_year` (
	`a` int(11) NOT NULL AUTO_INCREMENT,
	`b` date DEFAULT NULL,
	PRIMARY KEY (`a`),
	KEY `auto_shard_key_b` USING BTREE (`b`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 TTL = TTL_DEFINITION ( TTL_ENABLE = 'OFF', TTL_EXPR = `b` EXPIRE AFTER 1 year TIMEZONE '+08:00', TTL_JOB = CRON '0 0 2 * * ? *', TTL_CLEANUP = 'ON', TTL_PART_INTERVAL = INTERVAL(1, YEAR), ARCHIVE_TYPE = 'PARTITION', ARCHIVE_TABLE_NAME = '', ARCHIVE_TABLE_PRE_ALLOCATE = 4, ARCHIVE_TABLE_POST_ALLOCATE = 2 )
PARTITION BY RANGE COLUMNS(`b`)
(PARTITION p1 VALUES LESS THAN ('2025-01-01') ENGINE = InnoDB,
 PARTITION p2 VALUES LESS THAN ('2026-01-01') ENGINE = InnoDB,
 PARTITION p3 VALUES LESS THAN ('2027-01-01') ENGINE = InnoDB)
