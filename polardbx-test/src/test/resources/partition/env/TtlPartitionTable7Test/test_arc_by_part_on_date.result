	`a` int(11) NOT NULL AUTO_INCREMENT,
	`b` date DEFAULT NULL,
	PRIMARY KEY (`a`),
	CLUSTERED COLUMNAR INDEX `arctmp_arc_date_t1_arc` (`b`)
		PARTITION BY RANGE COLUMNS(`b`)
		(PARTITION p20240101 VALUES LESS THAN ('2024-01-01') ENGINE = Columnar,
