## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
## LOCALITY_DN_LIST: $dn1, $dn2;
## test dble_db
set ENABLE_PUSH_DOWN_AUTO_INCREMENT=true;
set DEFAULT_COLLATION_FOR_UTF8MB4='utf8mb4_bin';
set COLLATION_SERVER='utf8mb4_bin';
set ENABLE_POST_PLANNER_PARTITION_HINT_PRUNING=true;
set ENABLE_RANDOM_PHY_TABLE_NAME=false;
set ENABLE_REPLICAS_RANDOM_READ= false;
use polardbx;
drop database if exists mydbledb2;
## USE_DN_LIST_MSG
create database if not exists mydbledb2 mode = 'auto' locality='dble_config={"group_config":{"mydbledb2_g1":["$dn1","mydbledb2_00"],"mydbledb2_g2":["$dn2","mydbledb2_01"] }}';
use mydbledb2;
#bro   sig   part
#bro     ok     ok    ok
#sig     ok     ok    no
#part    ok     no    maybe
#
#
#
#bro   sig   	part      rep
#bro     ok     ok    	ok        ok
#sig     ok     ok    	no		  maybe
#part    ok     no    	maybe     maybe*
#rep     ok     maybe  	maybe*	  maybe*
#
#
#rep-rep
CREATE TABLE `k_t1` (
`a` int(11) DEFAULT NULL
) ENGINE = InnoDB DEFAULT CHARSET = utf8
PARTITION BY KEY(a)
PARTITIONS 2
LOCALITY='db_pools=mydbledb2_g1,mydbledb2_g2';
CREATE TABLE `k_t2` (
`a` int(11) DEFAULT NULL
) ENGINE = InnoDB DEFAULT CHARSET = utf8
PARTITION BY KEY(a)
PARTITIONS 2
LOCALITY='db_pools=mydbledb2_g1,mydbledb2_g2';
CREATE TABLE `s_t_g1` (
`a` int(11) DEFAULT NULL
) ENGINE = InnoDB DEFAULT CHARSET = utf8
SINGLE
LOCALITY='db_pools=mydbledb2_g1';
CREATE TABLE `s_t_g2` (
`a` int(11) DEFAULT NULL
) ENGINE = InnoDB DEFAULT CHARSET = utf8
SINGLE
LOCALITY='db_pools=mydbledb2_g2';
CREATE TABLE `b_t1` (
`a` int(11) DEFAULT NULL
) ENGINE = InnoDB DEFAULT CHARSET = utf8
BROADCAST
LOCALITY='db_pools=mydbledb2_g1,mydbledb2_g2';
CREATE TABLE `r_t_all` (
`a` int(11) DEFAULT NULL
) ENGINE = InnoDB DEFAULT CHARSET = utf8
REPLICAS
LOCALITY='db_set=mydbledb2_g1,mydbledb2_g2';
CREATE TABLE `r_t2_all` (
