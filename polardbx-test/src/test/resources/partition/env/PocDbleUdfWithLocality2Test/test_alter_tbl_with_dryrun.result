## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
## LOCALITY_DN_LIST: $dn1, $dn2;
## test dble_db
set ENABLE_PUSH_DOWN_AUTO_INCREMENT=true;
set DEFAULT_COLLATION_FOR_UTF8MB4='utf8mb4_bin';
set COLLATION_SERVER='utf8mb4_bin';
use polardbx;
drop database if exists dbledb3;
## USE_DN_LIST_MSG
create database if not exists dbledb3 mode = 'auto' locality='dble_config={"group_config":{"dbledb3_g1":["$dn1","dbledb3_00"],"dbledb3_g2":["$dn2","dbledb3_01"] }}';
use dbledb3;
show tables;
Tables_in_dbledb3
use polardbx;
unregister database if exists dbledb3;
## USE_DN_LIST_MSG
register database if not exists dbledb3 mode = 'auto' locality='dble_config={"group_config":{"dbledb3_g1":["$dn1","dbledb3_00"],"dbledb3_g2":["$dn2","dbledb3_01"] }}';
use dbledb3;
show tables;
Tables_in_dbledb3
## test unregister table
drop table if exists dbledb3_t1;
create table if not exists dbledb3_t1 (
    a bigint ,
    b bigint not null auto_increment,
    primary key(b)
)
partition by key(a)
partitions 2
locality='db_pools=dbledb3_g1,dbledb3_g2';
unregister table if exists dbledb3_t1;
show tables;
Tables_in_dbledb3
## test register table
register table if not exists dbledb3_t1 (a int , b bigint not null auto_increment, primary key(b))
partition by udf_hash(
  `a` with udf_params(
    'dble/hash',
    '{"partitionCount": "2", "partitionLength" : "100"}'
  )
)
partitions 2
locality='db_pools=dbledb3_g1,dbledb3_g2';
show create table dbledb3_t1;
Table,Create Table
dbledb3_t1,CREATE TABLE `dbledb3_t1` (
	`a` bigint(20) DEFAULT NULL,
	`b` bigint(20) NOT NULL AUTO_INCREMENT,
	PRIMARY KEY (`b`),
	KEY `auto_shard_key_a` USING BTREE (`a`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 DEFAULT COLLATE = utf8mb4_bin
/* LOCALITY='db_pools=dbledb3_g1,dbledb3_g2' */
PARTITION BY UDF_HASH(`a` WITH UDF_PARAMS (
'dble/hash',
'{"partitionCount": "2", "partitionLength" : "100"}'
))
PARTITIONS 2
(PARTITION p1 VALUES LESS THAN (1) ENGINE = InnoDB,
 PARTITION p2 VALUES LESS THAN (9223372036854775807) ENGINE = InnoDB)
show tables;
Tables_in_dbledb3
dbledb3_t1
select a,b from dbledb3_t1 order by a,b;
a,b
check table routing dbledb3_t1;
route_part,real_part,a
show create table dbledb3_t1;
Table,Create Table
dbledb3_t1,CREATE TABLE `dbledb3_t1` (
