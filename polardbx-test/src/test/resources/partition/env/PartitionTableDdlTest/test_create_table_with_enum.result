DROP TABLE IF EXISTS t_enum_tb1
CREATE TABLE t_enum_tb1 (
	id int NOT NULL,
	e1 enum('a', 'c', 'b') NOT NULL,
	e2 enum('a@1', 'a-b-c', 'eric,fu', '''hello''world', 'fu,eric')
)
SHOW CREATE TABLE t_enum_tb1
Table,Create Table
t_enum_tb1,CREATE TABLE `t_enum_tb1` (
	`id` int(11) NOT NULL,
	`e1` enum('a', 'c', 'b') NOT NULL,
	`e2` enum('a@1', 'a-b-c', 'eric,fu', '''hello''world', 'fu,eric') DEFAULT NULL
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
INSERT INTO t_enum_tb1
VALUES (1, 'a', 'a@1'),
	(2, 'b', 'a-b-c'),
	(3, 'c', 3),
	(4, 'a', 'fu,eric'),
	(5, 'b', '''hello''world')
