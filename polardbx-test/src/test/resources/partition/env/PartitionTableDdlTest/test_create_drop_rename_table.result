## DISABLE_FAST_SQL_PARSER
drop database if exists test_create_drop_rename_table
create database test_create_drop_rename_table mode = 'auto'
use test_create_drop_rename_table
create table t1 (
  a int,
  b varchar(10),
  c bigint,
  index local_idx_b(b),
  global index global_idx_b(b) partition by key(b) partitions 5,
  clustered index clustered_idx_c(c) partition by key(c) partitions 2
) partition by key(a) partitions 3
create table t2 (
  d int,
  e varchar(10),
  f bigint,
  index local_idx_d(d),
  global index global_idx_d(d) partition by key(d) partitions 2,
  clustered index clustered_idx_f(f) partition by key(f) partitions 3
) partition by key(d) partitions 4
show create table t1
Table,Create Table
t1,CREATE TABLE `t1` (
	`a` int(11) DEFAULT NULL,
	`b` varchar(10) DEFAULT NULL,
	`c` bigint(20) DEFAULT NULL,
	CLUSTERED INDEX `clustered_idx_c` (`c`)
		PARTITION BY KEY(`c`)
		PARTITIONS 2,
	GLOBAL INDEX `global_idx_b` (`b`) COVERING (`a`)
		PARTITION BY KEY(`b`)
		PARTITIONS 5,
	KEY `local_idx_b` (`b`),
	KEY `auto_shard_key_a` USING BTREE (`a`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
PARTITION BY KEY(`a`)
PARTITIONS 3
show create table t2
Table,Create Table
t2,CREATE TABLE `t2` (
	`d` int(11) DEFAULT NULL,
	`e` varchar(10) DEFAULT NULL,
	`f` bigint(20) DEFAULT NULL,
	CLUSTERED INDEX `clustered_idx_f` (`f`)
		PARTITION BY KEY(`f`)
		PARTITIONS 3,
	GLOBAL INDEX `global_idx_d` (`d`)
		PARTITION BY KEY(`d`)
		PARTITIONS 2,
	KEY `local_idx_d` (`d`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
PARTITION BY KEY(`d`)
PARTITIONS 4
alter table t1 drop index global_idx_b
show table replicate status order by gsi_name
TABLE_NAME,GSI_NAME,REPLICATE_STATUS,GSI_STATUS,GSI_VISIBILITY
t1,-,PUBLIC,-,-
t2,-,PUBLIC,-,-
