DROP DATABASE IF EXISTS test_statistics3
CREATE DATABASE test_statistics3 MODE auto
USE test_statistics3
DROP TABLE IF EXISTS t_statistics3
CREATE TABLE t_statistics3 (
	id int,
	name varchar(60),
	NAME2 varchar(60),
	Name3 varchar(60),
	PRIMARY KEY (id)
)
PARTITION BY KEY (id) PARTITIONS 4
ALTER TABLE T_statistics3
	ADD INDEX IDX_name (Name, NAME2(10), namE3)
ALTER TABLE t_STATISTICS3
	ADD INDEX idx_NAME2 (nAme(10), naMe2(10), name3(10))
ALTER TABLE t_statistics3
	ADD GLOBAL INDEX idx_Name3 (Name, NAME2(10), namE3) PARTITION BY KEY (name)
ALTER TABLE t_statistics3
	ADD GLOBAL INDEX idx_name4 (nAme(10), naMe2(10), name3(10)) PARTITION BY KEY (name)
SHOW CREATE TABLE t_statistics3
TABLE,CREATE TABLE
t_statistics3,CREATE TABLE `t_statistics3` (
	`id` int(11) NOT NULL,
	`name` varchar(60) DEFAULT NULL,
	`NAME2` varchar(60) DEFAULT NULL,
	`Name3` varchar(60) DEFAULT NULL,
	PRIMARY KEY (`id`),
	GLOBAL INDEX `idx_Name3` (`Name`, `NAME2`(10), `namE3`)
		PARTITION BY KEY(`name`)
		PARTITIONS 3,
	GLOBAL INDEX `idx_name4` (`nAme`(10), `naMe2`(10), `name3`(10))
		PARTITION BY KEY(`name`)
		PARTITIONS 3,
	KEY `IDX_name` (`name`, `NAME2`(10), `Name3`),
	KEY `idx_NAME2` (`name`(10), `NAME2`(10), `Name3`(10))
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
PARTITION BY KEY(`id`)
PARTITIONS 4
