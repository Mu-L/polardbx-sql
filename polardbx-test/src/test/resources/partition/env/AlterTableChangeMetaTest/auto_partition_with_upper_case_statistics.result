DROP DATABASE IF EXISTS test_statistics
CREATE DATABASE test_statistics MODE auto
USE test_statistics
DROP TABLE IF EXISTS t_statistics4
CREATE TABLE t_statistics4 (
	id int,
	name varchar(60),
	NAME2 varchar(60),
	Name3 varchar(60),
	PRIMARY KEY (id),
	INDEX `INDEX_NAME` USING BTREE(`NAME`),
	INDEX `idx_name2` USING BTREE(`name2`)
)
SHOW CREATE TABLE t_statistics4
TABLE,CREATE TABLE
t_statistics4,CREATE TABLE `t_statistics4` (
	`id` int(11) NOT NULL,
	`name` varchar(60) DEFAULT NULL,
	`NAME2` varchar(60) DEFAULT NULL,
	`Name3` varchar(60) DEFAULT NULL,
	PRIMARY KEY (`id`),
	INDEX `idx_name2` USING BTREE (`name2`),
	INDEX `INDEX_NAME` USING BTREE (`NAME`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
