## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
## LOCALITY_DN_LIST: $dn1, $dn2;
set ROUTE_TUPLE_USE_PRECHECK_BY_UDF_FUNC=true;
set ROUTE_TUPLE_IGNORE_BAD_VALUE_TYPE_CAST=true;
set ENABLE_PUSH_DOWN_AUTO_INCREMENT=true;
create table patternrange_table (
  id int
  )
  partition by UDF_HASH(
  `id` with udf_params(
  'dble/patternrange',
  '{
"defaultNode" : "3",
"patternValue" : "1000",
"mapFile" :
  "
         0-255=0
		256-500=1
		501-755=2
		756-1000=3
        "
}'
  )
)
partitions 4;
select part_route('','patternrange_table',null);
part_route('', 'patternrange_table', NULL)
p4
select part_route('','patternrange_table',-1);
part_route('', 'patternrange_table', -1)
p4
select part_route('','patternrange_table',0);
part_route('', 'patternrange_table', 0)
p1
select part_route('','patternrange_table',255);
part_route('', 'patternrange_table', 255)
p1
select part_route('','patternrange_table',256);
part_route('', 'patternrange_table', 256)
p2
select part_route('','patternrange_table',500);
part_route('', 'patternrange_table', 500)
p2
select part_route('','patternrange_table',501);
part_route('', 'patternrange_table', 501)
p3
select part_route('','patternrange_table',755);
part_route('', 'patternrange_table', 755)
p3
select part_route('','patternrange_table',756);
part_route('', 'patternrange_table', 756)
p4
select part_route('','patternrange_table',1000);
part_route('', 'patternrange_table', 1000)
p1
select part_route('','patternrange_table',1001);
part_route('', 'patternrange_table', 1001)
p1
