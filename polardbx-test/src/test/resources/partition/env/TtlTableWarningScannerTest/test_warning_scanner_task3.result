drop table if exists ttl_wrong_cci;
create table ttl_wrong_cci(
a int not null auto_increment,
b datetime,
primary key(a)
)
partition by key(a)
partitions 4;
alter table ttl_wrong_cci modify ttl set TTL_ENABLE='ON', TTL_CLEANUP='ON', TTL_EXPR = `b` EXPIRE AFTER 2 DAY TIMEZONE '+08:00',ARCHIVE_TABLE_PRE_ALLOCATE = 7,ARCHIVE_TABLE_POST_ALLOCATE = 2, ARCHIVE_TYPE='ROW';
create table ttl_wrong_cci_arc like ttl_wrong_cci engine='columnar' archive_mode='ttl';
show create table ttl_wrong_cci;
