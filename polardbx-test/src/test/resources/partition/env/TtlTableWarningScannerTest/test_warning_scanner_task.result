## DISABLE_FAST_SQL_PARSER
use polardbx
drop database if exists test_warning_scan_db
create database if not exists test_warning_scan_db mode='auto'
use test_warning_scan_db
set TTL_DEBUG_CCI_SKIP_DDL_TASKS = "WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask"
set SKIP_DDL_TASKS="WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask"
set ENABLE_DROP_TRUNCATE_CCI_PARTITION =true
set TTL_FORBID_DROP_TTL_TBL_WITH_ARC_CCI = false
set TTL_DEBUG_CURRENT_DATETIME='2024-06-27 00:00:00'
set TTL_DEBUG_WARNING_SCAN_TTLINFO_MODIFIED_TIME='2024-05-27 00:00:00'
set TTL_ONLY_SCHEDULED_WARNING_SCANNER_TASK=true
set TTL_ONLY_WARNING_FOR_THE_LAST_PART=true
set TTL_WARNING_DELAY_SECONDS_AFTER_TTL_MODIFIED=1
set TTL_DEBUG_WARNING_SCAN_TARGET_SCHEMA='test_warning_scan_db'
## case 0: only max-value part left
drop table if exists ttl_rng_t0
create table ttl_rng_t0(
a int not null auto_increment,
b datetime,
primary key(a)
)
partition by range columns(b)
(
partition p1 values less than('2022-01-01'),
partition pm values less than(Maxvalue)
)
alter table ttl_rng_t0 modify ttl set TTL_ENABLE='ON', TTL_EXPR = `b` EXPIRE AFTER 2 MONTH TIMEZONE '+08:00',ARCHIVE_TABLE_PRE_ALLOCATE = 12,ARCHIVE_TABLE_POST_ALLOCATE = 2, ARCHIVE_TYPE='PARTITION'
show create table ttl_rng_t0
Table,Create Table
ttl_rng_t0,CREATE TABLE `ttl_rng_t0` (
	`a` int(11) NOT NULL AUTO_INCREMENT,
	`b` datetime DEFAULT NULL,
	PRIMARY KEY (`a`),
	KEY `auto_shard_key_b` USING BTREE (`b`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 TTL = TTL_DEFINITION ( TTL_ENABLE = 'ON', TTL_EXPR = `b` EXPIRE AFTER 2 MONTH TIMEZONE '+08:00', TTL_JOB = CRON '0 0 2 * * ? *', TTL_CLEANUP = 'OFF', TTL_PART_INTERVAL = INTERVAL(1, MONTH), ARCHIVE_TYPE = 'PARTITION', ARCHIVE_TABLE_NAME = '', ARCHIVE_TABLE_PRE_ALLOCATE = 12, ARCHIVE_TABLE_POST_ALLOCATE = 2 )
PARTITION BY RANGE COLUMNS(`b`)
(PARTITION p1 VALUES LESS THAN ('2022-01-01 00:00:00') ENGINE = InnoDB,
 PARTITION pm VALUES LESS THAN (MAXVALUE) ENGINE = InnoDB)
set TTL_DEBUG_WARNING_SCAN_TARGET_TABLE='ttl_rng_t0'
/*+TDDL:cmd_extra(TTL_ONLY_SCHEDULED_WARNING_SCANNER_TASK=true)*/fire schedule by table ttl_rng_t0
WARNING_TABLE,WARNING_MSG
`test_warning_scan_db`.`ttl_rng_t0`,The last maxvalue part is using for current_time[2024-06-27 00:00:00]
drop table if exists ttl_rng_t0
