## DISABLE_FAST_SQL_PARSER
set ALLOW_USING_TIMESTAMP_IN_RANGE_LIST_PARTITION=true
DROP TABLE IF EXISTS `hash_ts_using_month`
CREATE /*+TDDL:cmd_extra(ALLOW_USING_TIMESTAMP_IN_RANGE_LIST_PARTITION=true)*/ TABLE IF NOT EXISTS `hash_ts_using_month` (
`a` varchar(8) DEFAULT NULL,
`b` timestamp default current_timestamp
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 COLLATE = utf8mb4_general_ci
PARTITION BY hash(month(`b`))
PARTITIONS 12
set time_zone='+08:00'
insert into hash_ts_using_month values (1,'2024-01-01 00:00:00')
insert into hash_ts_using_month values (2,'2024-01-01 09:00:00')
insert into hash_ts_using_month values (3,'2024-01-01 00:00:00')
set time_zone='+08:00'
select a,b, month(b),part_route('','hash_ts_using_month', b) from hash_ts_using_month order by a
a,b,month(b),part_route('', 'hash_ts_using_month', b)
1,2024-01-01 00:00:00.0,1,p1
2,2024-01-01 09:00:00.0,1,p1
3,2024-01-01 00:00:00.0,1,p1
set time_zone='+00:00'
select a,b, month(b),part_route('','hash_ts_using_month', b) from hash_ts_using_month order by a
a,b,month(b),part_route('', 'hash_ts_using_month', b)
1,2023-12-31 16:00:00.0,12,p1
2,2024-01-01 01:00:00.0,1,p1
3,2023-12-31 16:00:00.0,12,p1
set time_zone='+08:00'
explain select a,b from hash_ts_using_month where b='2024-02-02 02:00:00'
Logical ExecutionPlan
PhyTableOperation(tables="hash_ts_using_month[p4]", sql="SELECT `hash_ts_using_month`.`a` AS `a`, `hash_ts_using_month`.`b` AS `b` FROM ? AS `hash_ts_using_month` WHERE (`hash_ts_using_month`.`b` = ?)", params="2024-02-02 02:00:00")
set time_zone='+00:00'
explain select a,b from hash_ts_using_month where b='2024-02-01 18:00:00'
Logical ExecutionPlan
PhyTableOperation(tables="hash_ts_using_month[p4]", sql="SELECT `hash_ts_using_month`.`a` AS `a`, `hash_ts_using_month`.`b` AS `b` FROM ? AS `hash_ts_using_month` WHERE (`hash_ts_using_month`.`b` = ?)", params="2024-02-01 18:00:00")
explain  select a,b from hash_ts_using_month where b between '2023-12-31 18:00:00' and '2024-04-01 18:00:00'
Logical ExecutionPlan
Gather(concurrent=true)
  LogicalView(tables="hash_ts_using_month[p1,p4,p5,p11]", shardCount=4, sql="SELECT `a`, `b` FROM `hash_ts_using_month` AS `hash_ts_using_month` WHERE (`b` BETWEEN ? AND ?)")
DROP TABLE IF EXISTS `hash_ts_using_month`;