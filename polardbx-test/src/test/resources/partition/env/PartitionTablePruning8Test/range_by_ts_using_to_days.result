## DISABLE_FAST_SQL_PARSER
set ALLOW_USING_TIMESTAMP_IN_RANGE_LIST_PARTITION=true
set time_zone='+08:00'
DROP TABLE IF EXISTS `rng_ts_using_todays`
CREATE /*+TDDL:cmd_extra(ALLOW_USING_TIMESTAMP_IN_RANGE_LIST_PARTITION=true)*/ TABLE IF NOT EXISTS `rng_ts_using_todays` (
`a` varchar(8) DEFAULT NULL,
`b` timestamp default current_timestamp
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 COLLATE = utf8mb4_general_ci
PARTITION BY range(to_days(b))
(
PARTITION p20250101 VALUES LESS THAN (to_days('2025-01-02')),
PARTITION p20250102 VALUES LESS THAN (to_days('2025-01-03')),
PARTITION p20250103 VALUES LESS THAN (to_days('2025-01-04')),
PARTITION p20250104 VALUES LESS THAN (to_days('2025-01-05')),
PARTITION p20250105 VALUES LESS THAN (to_days('2025-01-06')),
PARTITION pmax VALUES LESS THAN (maxvalue)
)
DROP TABLE IF EXISTS `rng_dt_using_todays`
CREATE /*+TDDL:cmd_extra(ALLOW_USING_TIMESTAMP_IN_RANGE_LIST_PARTITION=true)*/ TABLE IF NOT EXISTS `rng_dt_using_todays` (
`a` varchar(8) DEFAULT NULL,
`b` datetime default current_timestamp
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 COLLATE = utf8mb4_general_ci
PARTITION BY range(to_days(b))
(
PARTITION p20250101 VALUES LESS THAN (to_days('2025-01-02')),
PARTITION p20250102 VALUES LESS THAN (to_days('2025-01-03')),
PARTITION p20250103 VALUES LESS THAN (to_days('2025-01-04')),
PARTITION p20250104 VALUES LESS THAN (to_days('2025-01-05')),
PARTITION p20250105 VALUES LESS THAN (to_days('2025-01-06')),
PARTITION pmax VALUES LESS THAN (maxvalue)
)
set time_zone='+08:00'
explain select a,b from rng_dt_using_todays where b='2025-01-02 02:00:00'
Logical ExecutionPlan
PhyTableOperation(tables="rng_dt_using_todays[p20250102]", sql="SELECT `rng_dt_using_todays`.`a` AS `a`, `rng_dt_using_todays`.`b` AS `b` FROM ? AS `rng_dt_using_todays` WHERE (`rng_dt_using_todays`.`b` = ?)", params="2025-01-02 02:00:00")
set time_zone='+00:00'
explain select a,b from rng_dt_using_todays where b='2025-01-01 18:00:00'
Logical ExecutionPlan
