## DISABLE_FAST_SQL_PARSER
set ALLOW_USING_TIMESTAMP_IN_RANGE_LIST_PARTITION=true
DROP TABLE IF EXISTS `list_ts_using_month`
CREATE /*+TDDL:cmd_extra(ALLOW_USING_TIMESTAMP_IN_RANGE_LIST_PARTITION=true)*/ TABLE IF NOT EXISTS `list_ts_using_month` (
`a` varchar(8) DEFAULT NULL,
`b` timestamp default current_timestamp
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 COLLATE = utf8mb4_general_ci
PARTITION BY list(month(`b`))
(
  PARTITION p1 VALUES IN (1),
  PARTITION p2 VALUES IN (2),
  PARTITION p3 VALUES IN (3),
  PARTITION p4 VALUES IN (4),
  PARTITION p5 VALUES IN (5),
  PARTITION p6 VALUES IN (6),
  PARTITION p7 VALUES IN (7),
  PARTITION p8 VALUES IN (8),
  PARTITION p9 VALUES IN (9),
  PARTITION p10 VALUES IN (10),
  PARTITION p11 VALUES IN (11),
  PARTITION p12 VALUES IN (12),
  PARTITION pd VALUES IN (default)
)
set time_zone='+08:00'
insert into list_ts_using_month values (1,'2024-01-01 00:00:00')
insert into list_ts_using_month values (2,'2024-01-01 09:00:00')
insert into list_ts_using_month values (3,'2024-01-01 00:00:00')
set time_zone='+08:00'
select a,b, month(b),part_route('','list_ts_using_month', b) from list_ts_using_month order by a
a,b,month(b),part_route('', 'list_ts_using_month', b)
1,2024-01-01 00:00:00.0,1,p1
2,2024-01-01 09:00:00.0,1,p1
3,2024-01-01 00:00:00.0,1,p1
set time_zone='+00:00'
select a,b, month(b),part_route('','list_ts_using_month', b) from list_ts_using_month order by a
a,b,month(b),part_route('', 'list_ts_using_month', b)
1,2023-12-31 16:00:00.0,12,p1
2,2024-01-01 01:00:00.0,1,p1
3,2023-12-31 16:00:00.0,12,p1
set time_zone='+08:00'
explain select a,b from list_ts_using_month where b='2024-02-02 02:00:00'
Logical ExecutionPlan
PhyTableOperation(tables="list_ts_using_month[p2]", sql="SELECT `list_ts_using_month`.`a` AS `a`, `list_ts_using_month`.`b` AS `b` FROM ? AS `list_ts_using_month` WHERE (`list_ts_using_month`.`b` = ?)", params="2024-02-02 02:00:00")
set time_zone='+00:00'
explain select a,b from list_ts_using_month where b='2024-02-01 18:00:00'
Logical ExecutionPlan
PhyTableOperation(tables="list_ts_using_month[p2]", sql="SELECT `list_ts_using_month`.`a` AS `a`, `list_ts_using_month`.`b` AS `b` FROM ? AS `list_ts_using_month` WHERE (`list_ts_using_month`.`b` = ?)", params="2024-02-01 18:00:00")
explain  select a,b from list_ts_using_month where b between '2023-12-31 18:00:00' and '2024-04-01 18:00:00'
Logical ExecutionPlan
Gather(concurrent=true)
  LogicalView(tables="list_ts_using_month[p1,p2,p3,p4]", shardCount=4, sql="SELECT `a`, `b` FROM `list_ts_using_month` AS `list_ts_using_month` WHERE (`b` BETWEEN ? AND ?)")
DROP TABLE IF EXISTS `list_ts_using_month`;