select a,b from cobar_enum_0_p5 where a=10030;
a,b
10030,10030
drop table if exists cobar_enum_0_p5;
### ======== multi-dimension =========
drop table if exists cobar_hash_strhash;
create table cobar_hash_strhash (a bigint，b varchar(32))
partition by udf_hash (
  `a` with udf_params (
  'cobar/PartitionByLong',
  '{
          "partitionCount" : "4",
          "partitionLength" : "128"
   }'
  )
)
partitions 4
subpartition by udf_hash (
  `b` with udf_params (
  'cobar/PartitionByString',
  '{
          "partitionCount" : "8",
          "partitionLength" : "128",
          "hashSlice" : "0:8"
  }'
  )
)
subpartitions 8;
show create table cobar_hash_strhash;
Table,Create Table
cobar_hash_strhash,CREATE TABLE `cobar_hash_strhash` (
	`a` bigint(20) DEFAULT NULL,
	`b` varchar(32) DEFAULT NULL,
	KEY `auto_shard_key_a` USING BTREE (`a`),
	KEY `auto_shard_key_b` USING BTREE (`b`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
PARTITION BY UDF_HASH(`a` WITH UDF_PARAMS (
'cobar/PartitionByLong',
'{
          "partitionCount" : "4",
          "partitionLength" : "128"
   }'
))
PARTITIONS 4
SUBPARTITION BY UDF_HASH(`b` WITH UDF_PARAMS (
'cobar/PartitionByString',
'{
          "partitionCount" : "8",
          "partitionLength" : "128",
          "hashSlice" : "0:8"
  }'
))
SUBPARTITIONS 8
(SUBPARTITION sp1 VALUES LESS THAN (1),
 SUBPARTITION sp2 VALUES LESS THAN (2),
 SUBPARTITION sp3 VALUES LESS THAN (3),
 SUBPARTITION sp4 VALUES LESS THAN (4),
 SUBPARTITION sp5 VALUES LESS THAN (5),
 SUBPARTITION sp6 VALUES LESS THAN (6),
 SUBPARTITION sp7 VALUES LESS THAN (7),
 SUBPARTITION sp8 VALUES LESS THAN (9223372036854775807))
(PARTITION p1 VALUES LESS THAN (1),
 PARTITION p2 VALUES LESS THAN (2),
 PARTITION p3 VALUES LESS THAN (3),
 PARTITION p4 VALUES LESS THAN (9223372036854775807))
