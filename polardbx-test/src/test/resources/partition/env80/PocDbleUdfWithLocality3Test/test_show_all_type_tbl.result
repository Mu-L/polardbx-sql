))
PARTITIONS 2
(PARTITION p1 VALUES LESS THAN (1) ENGINE = InnoDB,
 PARTITION p2 VALUES LESS THAN (9223372036854775807) ENGINE = InnoDB)
## ===== test create tbl using dble/unitmurmurhash tbl with 4 partitions =======
  create table if not exists dblemurhash_p4_t1 (a varchar(4) , b bigint not null auto_increment, primary key(b))
  partition by udf_hash(
  `a` with udf_params(
  'dble/unitmurmurhash',
  '{
            "partitionCount": "4",
            "isDigitCheck" : "1",
            "leftPaddingChar" : "NO",
            "shardingValueMaxLength" : "15"
    }'
  )
  )
  partitions 4
  locality='db_pools=g1,g2,g3,g4';
show create table dblemurhash_p4_t1;
Table,Create Table
dblemurhash_p4_t1,CREATE TABLE `dblemurhash_p4_t1` (
	`a` varchar(4) COLLATE utf8mb4_bin DEFAULT NULL,
	`b` bigint(20) NOT NULL AUTO_INCREMENT,
	PRIMARY KEY (`b`),
	KEY `auto_shard_key_a` USING BTREE (`a`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 DEFAULT COLLATE = utf8mb4_bin
LOCALITY='db_pools=g1,g2,g3,g4'
PARTITION BY UDF_HASH(`a` WITH UDF_PARAMS (
'dble/unitmurmurhash',
'{
            "partitionCount": "4",
            "isDigitCheck" : "1",
            "leftPaddingChar" : "NO",
            "shardingValueMaxLength" : "15"
    }'
))
PARTITIONS 4
(PARTITION p1 VALUES LESS THAN (1) ENGINE = InnoDB,
 PARTITION p2 VALUES LESS THAN (2) ENGINE = InnoDB,
 PARTITION p3 VALUES LESS THAN (3) ENGINE = InnoDB,
 PARTITION p4 VALUES LESS THAN (9223372036854775807) ENGINE = InnoDB)
## ===== test create tbl using dble_ext/mynewpartrange which mynewpartrange is user-defined dble udf =======
  create table dble_mynumrng_p8_t2(a bigint，b bigint)
  partition by udf_hash(
  `a` with udf_params (
  'dble_ext/partbyrangeudf',
  '{
        "defaultNode" : "0",　
        "mapFile" :
              "
                [range_definition]
                3-3=0
                4700-4700=1
                5001-5001=1
                5002-5002=2
                5101-5101=2
                5102-5102=3
                5103-5103=3
                [segments_default]
                0-1249=0
                1250-2499=0
                2500-3749=1
                3750-4999=1
                5000-6249=2
                6250-7499=2
                7500-8749=3
                8750-99999=3
              "
    }'
  )
  )
  partitions 4
  locality='db_pools=g[1,2,3,4]';
show create table dble_mynumrng_p8_t2;
Table,Create Table
dble_mynumrng_p8_t2,CREATE TABLE `dble_mynumrng_p8_t2` (
	`a` bigint(20) DEFAULT NULL,
	`b` bigint(20) DEFAULT NULL,
	KEY `auto_shard_key_a` USING BTREE (`a`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 DEFAULT COLLATE = utf8mb4_bin
LOCALITY='db_pools=g1,g2,g3,g4'
PARTITION BY UDF_HASH(`a` WITH UDF_PARAMS (
'dble_ext/partbyrangeudf',
'{
        "defaultNode" : "0",　
        "mapFile" :
              "
                [range_definition]
                3-3=0
                4700-4700=1
                5001-5001=1
                5002-5002=2
                5101-5101=2
                5102-5102=3
                5103-5103=3
                [segments_default]
                0-1249=0
                1250-2499=0
                2500-3749=1
                3750-4999=1
                5000-6249=2
                6250-7499=2
                7500-8749=3
                8750-99999=3
              "
    }'
))
PARTITIONS 4
(PARTITION p1 VALUES LESS THAN (1) ENGINE = InnoDB,
 PARTITION p2 VALUES LESS THAN (2) ENGINE = InnoDB,
 PARTITION p3 VALUES LESS THAN (3) ENGINE = InnoDB,
 PARTITION p4 VALUES LESS THAN (9223372036854775807) ENGINE = InnoDB)
## ===== test create replica tbl which locate on 1 replicas =======
  create table if not exists replicas_1p_t1 (a bigint , b bigint not null auto_increment, primary key(b))
  replicas
  locality='db_set=g1';
show create table replicas_1p_t1;
Table,Create Table
replicas_1p_t1,CREATE TABLE `replicas_1p_t1` (
	`a` bigint(20) DEFAULT NULL,
	`b` bigint(20) NOT NULL AUTO_INCREMENT,
	PRIMARY KEY (`b`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 DEFAULT COLLATE = utf8mb4_bin
LOCALITY='db_set=g1'
REPLICAS
