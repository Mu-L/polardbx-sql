## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
  ## LOCALITY_DN_LIST: $dn1, $dn2;
set ENABLE_PUSH_DOWN_AUTO_INCREMENT=true;
set DEFAULT_COLLATION_FOR_UTF8MB4='utf8mb4_bin';
set COLLATION_SERVER='utf8mb4_bin';
set OUTPUT_LOCALITY_WITHOUT_COMMENT=true;
## ===== test create database with locality =======
  use polardbx;
drop database if exists dbledb4gnew;
## USE_DN_LIST_MSG
  create database if not exists dbledb4gnew mode = 'auto' locality='db_config={"g[1-4]":["set[1,2,1,2]","dbledb4gnew_0[0-3]"]}';
use dbledb4gnew;
show tables;
Tables_in_dbledb4gnew
## ===== test create tbl using dble/hash tbl with 4 partitions =======
  ## USE_DN_LIST_MSG
  create table if not exists dblehash_p4_t1 (a int , b bigint not null auto_increment, primary key(b))
  partition by udf_hash(
  `a` with udf_params(
  'dble/hash',
  '{"partitionCount": "4", "partitionLength" : "100"}'
  )
)
partitions 4
locality='db_pools=g[1-4]';
show create table dblehash_p4_t1;
Table,Create Table
dblehash_p4_t1,CREATE TABLE `dblehash_p4_t1` (
	`a` int(11) DEFAULT NULL,
	`b` bigint(20) NOT NULL AUTO_INCREMENT,
	PRIMARY KEY (`b`),
	KEY `auto_shard_key_a` USING BTREE (`a`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 DEFAULT COLLATE = utf8mb4_bin
LOCALITY='db_pools=g1,g2,g3,g4'
PARTITION BY UDF_HASH(`a` WITH UDF_PARAMS (
'dble/hash',
'{"partitionCount": "4", "partitionLength" : "100"}'
))
PARTITIONS 4
(PARTITION p1 VALUES LESS THAN (1) ENGINE = InnoDB,
 PARTITION p2 VALUES LESS THAN (2) ENGINE = InnoDB,
 PARTITION p3 VALUES LESS THAN (3) ENGINE = InnoDB,
 PARTITION p4 VALUES LESS THAN (9223372036854775807) ENGINE = InnoDB)
## ===== test create tbl using dble/hash tbl with 2 partitions =======
