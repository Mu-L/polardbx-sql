## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
## LOCALITY_DN_LIST: $dn1, $dn2;
drop table if exists dblestrhash_tb_bi;
create table if not exists dblestrhash_tb_bi(a bigint)
charset utf8mb4 collate utf8mb4_bin
partition by udf_hash(
`a` with udf_params(
'dble/stringhash',
'{
  "partitionCount":"4",
  "partitionLength":"1",
  "hashSlice":"0:8"
}'
)
)
partitions 4;
