) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 TTL = TTL_DEFINITION ( TTL_ENABLE = 'OFF', TTL_EXPR = `b` EXPIRE AFTER 14 day TIMEZONE '+08:00', TTL_JOB = CRON '0 0 2 * * ? *', TTL_FILTER = COND_EXPR ( `c` IN (1, 2, 3) ) , TTL_CLEANUP = 'ON', TTL_PART_INTERVAL = INTERVAL(1, WEEK), ARCHIVE_TYPE = 'ROW', ARCHIVE_TABLE_NAME = 'test_ttl_interval_arc', ARCHIVE_TABLE_PRE_ALLOCATE = 2, ARCHIVE_TABLE_POST_ALLOCATE = 4 )
