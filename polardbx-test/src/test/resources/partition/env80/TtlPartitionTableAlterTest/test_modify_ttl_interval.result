	`a` int(11) NOT NULL,
	`b` datetime DEFAULT NULL,
	`c` int(11) DEFAULT NULL,
	PRIMARY KEY (`a`),
	CLUSTERED COLUMNAR INDEX `arctmp_test_ttl_interval_arc` (`b`)
		PARTITION BY RANGE COLUMNS(`b`)
