## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
## LOCALITY_DN_LIST: $dn1, $dn2;
create table dble_mypartlong_p8
(a bigint，b bigint)
partition by udf_hash(
    `a` with
    udf_params (
      'dble_ext/mynewpartlong',
      '{
        "partitionCount" : "8",　
        "partitionLength" : "360"
      }'
  )
)
partitions 8 (
  partition p1 values less than(1),
  partition p2 values less than(2),
  partition p3 values less than(3),
  partition p4 values less than(4),
  partition p5 values less than(5),
  partition p6 values less than(6),
  partition p7 values less than(7),
  partition p8 values less than(8)
);
show create table dble_mypartlong_p8;
Table,Create Table
dble_mypartlong_p8,CREATE TABLE `dble_mypartlong_p8` (
	`a` bigint(20) DEFAULT NULL,
	`b` bigint(20) DEFAULT NULL,
	KEY `auto_shard_key_a` USING BTREE (`a`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
PARTITION BY UDF_HASH(`a` WITH UDF_PARAMS (
'dble_ext/mynewpartlong',
'{
        "partitionCount" : "8",　
        "partitionLength" : "360"
      }'
))
PARTITIONS 8
(PARTITION p1 VALUES LESS THAN (1) ENGINE = InnoDB,
 PARTITION p2 VALUES LESS THAN (2) ENGINE = InnoDB,
 PARTITION p3 VALUES LESS THAN (3) ENGINE = InnoDB,
 PARTITION p4 VALUES LESS THAN (4) ENGINE = InnoDB,
 PARTITION p5 VALUES LESS THAN (5) ENGINE = InnoDB,
 PARTITION p6 VALUES LESS THAN (6) ENGINE = InnoDB,
 PARTITION p7 VALUES LESS THAN (7) ENGINE = InnoDB,
 PARTITION p8 VALUES LESS THAN (8) ENGINE = InnoDB)
create table dble_mypartlong_p10
(a bigint，b bigint)
partition by udf_hash(
    `a` with
    udf_params (
      'dble_ext/mynewpartlong',
      '{
        "partitionCount" : "8",　
        "partitionLength" : "360"
      }'
    )
  )
partitions 10;