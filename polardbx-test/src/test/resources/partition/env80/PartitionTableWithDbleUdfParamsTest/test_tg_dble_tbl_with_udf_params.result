## LOCALITY_DN_LIST: $dn1, $dn2;
create tablegroup if not exists mydbletg1;
drop table if exists dble_hash_tg_t1;
create table dble_hash_tg_t1
  (a bigint，b bigint)
  partition by udf_hash (
    `a` with udf_params (
      'dble/hash',
      '{"partitionCount" : "2,2","partitionLength" : "50,100"}'
    )
  ) partitions 4
  tablegroup=mydbletg1;
drop table if exists dble_hash_tg_t2;
create table dble_hash_tg_t2
  (a bigint，b bigint)
  partition by udf_hash (
    `a` with udf_params (
      'dble/hash',
      '{"partitionCount" : "2,2","partitionLength" : "50,100"}'
    )
  ) partitions 4
  tablegroup=mydbletg1;
drop table if exists dble_hash_tg_t3;
