## LOCALITY_DN_LIST: $dn1, $dn2;
## =================
create table dble_numrng_0_p5_t2
(a bigint，b bigint)
partition by udf_hash(
    `a` with
    udf_params (
      'dble/numberrange',
      '{
          "type" : "0",　
          "defaultNode" : "0",
          "mappings" :
            [
              "0-200M=0",
              "200M1-400M=1",
              "400M1-600M=2",
              "600M1-800M=3",
              "800M1-1000M=4"
            ]
      }'
  )
  )
  partitions 5 (
  partition p1 values less than(1),
  partition p2 values less than(2),
  partition p3 values less than(3),
  partition p4 values less than(4),
  partition p5 values less than(5)
  );
