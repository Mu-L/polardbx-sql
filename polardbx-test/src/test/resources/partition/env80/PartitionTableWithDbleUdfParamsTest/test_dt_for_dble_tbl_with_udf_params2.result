## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
## LOCALITY_DN_LIST: $dn1, $dn2;
create table dbleenum_i_t1
  (a int，b bigint)
  partition by udf_hash(
  `a` with
  udf_params (
    'dble/enum',
    '{
        "type" : "0",
        "defaultNode" : "3",　
        "mapFile" :
                  "
                    10000=0
                    10010=1
                    10020=2
                    10030=3
                    10040=4
                  "
    }'
  )
  )
  partitions 5;
create table dbleenum_bi_t1
  (a bigint，b bigint)
  partition by udf_hash(
  `a` with
  udf_params (
    'dble/enum',
  '{
        "type" : "0",　
        "defaultNode" : "3",
        "mapFile" :
                  "
                    10000=0
                    10010=1
                    10020=2
                    10030=3
                    10040=4
                  "
    }'
  )
  )
  partitions 5;
create table dbleenum_vc_t1
  (a varchar(3)，b bigint)
  partition by udf_hash(
  `a` with
  udf_params (
  'dble/enum',
  '{
        "type" : "1",　
        "defaultNode" : "0",
        "mapFile" :
                  "
                    ABC=0
                    BCD=1
                    EFG=2
                    hij=3
                    lmn=4
                  "
    }'
  )
  )
  partitions 5;
create table dbleenum_c_t1
  (a char(3)，b bigint)
  partition by udf_hash(
  `a` with
  udf_params (
  'dble/enum',
  '{
        "type" : "1",　
        "defaultNode" : "0",
        "mapFile" :
                  "
                    ABC=0
                    BCD=1
                    EFG=2
                    hij=3
                    lmn=4
                  "
    }'
  )
  )
  partitions 5;
set sql_mode='';
select part_route('','dbleenum_i_t1', '100');
part_route('', 'dbleenum_i_t1', '100')
p4
select part_route('','dbleenum_bi_t1', '100');
part_route('', 'dbleenum_bi_t1', '100')
p4
select part_route('','dbleenum_vc_t1', 'ABC');
part_route('', 'dbleenum_vc_t1', 'ABC')
p1
select part_route('','dbleenum_c_t1', 'ABC');
part_route('', 'dbleenum_c_t1', 'ABC')
p1
select part_route('','dbleenum_vc_t1', 'ABCD');
part_route('', 'dbleenum_vc_t1', 'ABCD')
p1
select part_route('','dbleenum_c_t1', 'ABCD');
part_route('', 'dbleenum_c_t1', 'ABCD')
p1
select part_route('','dbleenum_vc_t1', 'hij');
part_route('', 'dbleenum_vc_t1', 'hij')
p4
select part_route('','dbleenum_c_t1', 'hij');
part_route('', 'dbleenum_c_t1', 'hij')
p4
select part_route('','dbleenum_vc_t1', 'HIJ');
part_route('', 'dbleenum_vc_t1', 'HIJ')
p1
select part_route('','dbleenum_c_t1', 'HIJ');
part_route('', 'dbleenum_c_t1', 'HIJ')
p1
insert into dbleenum_vc_t1 (a,b) values ('ABCD', 1);
insert into dbleenum_vc_t1 (a,b) values ('ABCE', 2);
select * from dbleenum_vc_t1 order by b;
a,b
ABC,1
ABC,2
check table routing dbleenum_vc_t1;
route_part,real_part,a
insert into dbleenum_c_t1 (a,b) values ('ABCD', 1);
insert into dbleenum_c_t1 (a,b) values ('ABCE', 2);
select * from dbleenum_c_t1 order by b;
a,b
ABC,1
ABC,2
check table routing dbleenum_c_t1;
route_part,real_part,a