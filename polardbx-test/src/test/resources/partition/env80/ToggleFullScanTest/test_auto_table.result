## DISABLE_FAST_SQL_PARSER
drop database if exists test_auto_table_db
create database test_auto_table_db mode=auto
use test_auto_table_db
create table t9(id int, name varchar(20)) partition by key(id) partitions 3;
create table t1(id int, name varchar(20)) partition by key(id) partitions 3
insert into t1 values(1, 'aaa'), (2, 'bbb'), (3, 'ccc')
create table t2(id int, name varchar(20)) partition by key(id) partitions 2 subpartition by key(name) subpartitions 2
insert into t2 values(1, 'aaa'), (2, 'bbb'), (3, 'ccc')
create table t3(id int, name varchar(20)) broadcast
insert into t3 values(1, 'aaa'), (2, 'bbb'), (3, 'ccc')
create table t4(id int, name varchar(20)) broadcast
insert into t4 values(1, 'aaa'), (2, 'bbb'), (3, 'ccc')
create table t5(id int, name varchar(20)) single
insert into t5 values(1, 'aaa'), (2, 'bbb'), (3, 'ccc')
create table t6(id int, name varchar(20)) single
insert into t6 values(1, 'aaa'), (2, 'bbb'), (3, 'ccc')
select * from t1 order by id
id,name
1,aaa
2,bbb
3,ccc
