# LATIN1_BIN
    create table t_latin1_bin
    (
    id char(64) charset latin1 collate latin1_bin,
    name char(64),
    age int,
    salary decimal(10,2),
    create_time datetime,
    is_active boolean
    )
    partition by key(id)
    partitions 3
