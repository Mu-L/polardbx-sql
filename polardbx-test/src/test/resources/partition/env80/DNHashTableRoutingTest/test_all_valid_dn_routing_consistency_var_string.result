# LATIN1_SPANISH_CI
    create table t_latin1_spanish_ci
    (
    id varchar(64) charset latin1 collate latin1_spanish_ci,
    name varchar(64),
    age int,
    salary decimal(10,2),
    create_time datetime,
    is_active boolean
    )
    partition by key(id)
    partitions 3
