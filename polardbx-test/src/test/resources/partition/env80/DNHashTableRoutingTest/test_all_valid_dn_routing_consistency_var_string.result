# ASCII_BIN
    create table t_ascii_bin
    (
    id varchar(64) charset ascii collate ascii_bin,
    name varchar(64),
    age int,
    salary decimal(10,2),
    create_time datetime,
    is_active boolean
    )
    partition by key(id)
