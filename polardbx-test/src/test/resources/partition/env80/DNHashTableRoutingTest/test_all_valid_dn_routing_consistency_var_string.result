# UTF8MB4_UNICODE_CI
    create table t_utf8mb4_unicode_ci
    (
    id varchar(64) charset utf8mb4 collate utf8mb4_unicode_ci,
    name varchar(64),
    age int,
    salary decimal(10,2),
    create_time datetime,
    is_active boolean
    )
    partition by key(id)
