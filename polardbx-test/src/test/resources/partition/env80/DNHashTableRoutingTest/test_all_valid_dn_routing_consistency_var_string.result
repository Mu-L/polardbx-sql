# LATIN1_GENERAL_CS
    create table t_latin1_general_cs
    (
    id varchar(64) charset latin1 collate latin1_general_cs,
    name varchar(64),
    age int,
    salary decimal(10,2),
    create_time datetime,
    is_active boolean
    )
    partition by key(id)
    partitions 3
