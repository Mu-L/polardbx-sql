# ============================================================================
  # DATETIME 类型测试
  # ============================================================================
  # DATETIME 默认精度
create table t_datetime
(
id datetime,
name varchar(64),
age int,
salary decimal(10,2),
create_time datetime,
is_active boolean
)
partition by key(id)
partitions 3;
