# ============================================================================
  # DATE 类型测试
  # ============================================================================
  # DATE
create table t_date
(
id date,
name varchar(64),
age int,
salary decimal(10,2),
create_time datetime,
is_active boolean
)
partition by key(id)
partitions 3;
