# Set SQL mode to allow invalid data insertion
set sql_mode='';
set session SUPPORT_DATATYPE_FOR_INPLACE_BACKFILL=1111;
# TIMESTAMP 默认精度
create table t_timestamp_default
(
id timestamp,
name varchar(64),
age int,
salary decimal(10,2),
create_time datetime,
is_active boolean
)
partition by key(id)
partitions 3;
