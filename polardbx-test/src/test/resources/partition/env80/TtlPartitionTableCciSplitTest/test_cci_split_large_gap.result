## DISABLE_FAST_SQL_PARSER
set TTL_DEBUG_USE_GSI_FOR_COLUMNAR_ARC_TBL = false
set TTL_DEBUG_CCI_SKIP_DDL_TASKS = "WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask"
set TTL_DEBUG_CURRENT_DATETIME='2025-09-01 00:00:00'
set SKIP_DDL_TASKS="WaitColumnarTableAlterPartitionTask,WaitColumnarTableCreationTask"
create table test_cci_split_large_gap(
a int not null auto_increment,
b datetime default current_timestamp,
primary key(a)
)
ttl = ttl_definition( TTL_ENABLE = 'OFF' TTL_EXPR = `b` EXPIRE AFTER 2 MONTH TIMEZONE '+08:00' TTL_JOB = CRON '0 0 1 */2 * ? *' TIMEZONE '+08:00' ARCHIVE_TABLE_PRE_ALLOCATE = 2 ARCHIVE_TABLE_POST_ALLOCATE = 2 )
partition by key(a) partitions 2
show create table test_cci_split_large_gap
Table,Create Table
test_cci_split_large_gap,CREATE TABLE `test_cci_split_large_gap` (
	`a` int NOT NULL AUTO_INCREMENT,
	`b` datetime DEFAULT CURRENT_TIMESTAMP,
	PRIMARY KEY (`a`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 TTL = TTL_DEFINITION ( TTL_ENABLE = 'OFF', TTL_EXPR = `b` EXPIRE AFTER 2 MONTH TIMEZONE '+08:00', TTL_JOB = CRON '0 0 1 */2 * ? *', TTL_CLEANUP = 'OFF', TTL_PART_INTERVAL = INTERVAL(1, MONTH), ARCHIVE_TYPE = 'ROW', ARCHIVE_TABLE_NAME = '', ARCHIVE_TABLE_PRE_ALLOCATE = 2, ARCHIVE_TABLE_POST_ALLOCATE = 2 )
PARTITION BY KEY(`a`)
PARTITIONS 2
create table test_cci_split_large_gap_bk like test_cci_split_large_gap engine='columnar' archive_mode='ttl'
show create table test_cci_split_large_gap
Table,Create Table
test_cci_split_large_gap,CREATE TABLE `test_cci_split_large_gap` (
	`a` int NOT NULL AUTO_INCREMENT,
	`b` datetime DEFAULT CURRENT_TIMESTAMP,
	PRIMARY KEY (`a`),
	CLUSTERED COLUMNAR INDEX `arctmp_test_cci_split_large_gap_bk` (`b`)
		PARTITION BY RANGE COLUMNS(`b`)
		(PARTITION p20250701 VALUES LESS THAN ('2025-07-01 00:00:00') ENGINE = Columnar,
		 PARTITION p20250801 VALUES LESS THAN ('2025-08-01 00:00:00') ENGINE = Columnar,
		 PARTITION p20250901 VALUES LESS THAN ('2025-09-01 00:00:00') ENGINE = Columnar,
		 PARTITION p20251001 VALUES LESS THAN ('2025-10-01 00:00:00') ENGINE = Columnar,
		 PARTITION p20251101 VALUES LESS THAN ('2025-11-01 00:00:00') ENGINE = Columnar,
		 PARTITION p20251201 VALUES LESS THAN ('2025-12-01 00:00:00') ENGINE = Columnar,
		 PARTITION pmax VALUES LESS THAN (MAXVALUE) ENGINE = Columnar)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 TTL = TTL_DEFINITION ( TTL_ENABLE = 'OFF', TTL_EXPR = `b` EXPIRE AFTER 2 MONTH TIMEZONE '+08:00', TTL_JOB = CRON '0 0 1 */2 * ? *', TTL_CLEANUP = 'OFF', TTL_PART_INTERVAL = INTERVAL(1, MONTH), ARCHIVE_TYPE = 'ROW', ARCHIVE_TABLE_NAME = 'test_cci_split_large_gap_bk', ARCHIVE_TABLE_PRE_ALLOCATE = 2, ARCHIVE_TABLE_POST_ALLOCATE = 2 )
PARTITION BY KEY(`a`)
PARTITIONS 2
alter index arctmp_test_cci_split_large_gap_bk on table test_cci_split_large_gap
  split partition pmax into (
    partition p20980101 values less than ('2098-01-01 00:00:00'),
    partition p20990101 values less than ('2099-01-01 00:00:00'),
    partition p21000101 values less than ('2100-01-01 00:00:00'),
    partition pmax values less than (maxvalue)
  )
