insert into rep_t1_g0g1g2 values (1),(2),(3),(4),(5);
insert into rep_t2_g0g1g2 values (1),(2),(3),(4),(5);
insert into rep_t3_g1g2 values (1),(2),(3),(4),(5);
insert into rep_t4_g2g3 values (1),(2),(3),(4),(5);
insert into rep_t5_g3g4 values (1),(2),(3),(4),(5);
insert into rep_t6_g5 values (1),(2),(3),(4),(5);
insert into rep_t7_g0g3g4 values (1),(2),(3),(4),(5);
insert into rep_t8_g1g3g4 values (1),(2),(3),(4),(5);
insert into part_t1_g0g1g2 values (1),(2),(3),(4),(5);
insert into part_t2_g0g1g2 values (1),(2),(3),(4),(5);
insert into part_t3_g3g4 values (1),(2),(3),(4),(5);
insert into part_t4_g3g4 values (1),(2),(3),(4),(5);
insert into part_t5_g2 values (1),(2),(3),(4),(5);
insert into part_t6_g5 values (1),(2),(3),(4),(5);
## for generale stable plan, here close random read
set ENABLE_REPLICAS_RANDOM_READ= false;
### replicas-table random-read test ###
 ## random-read: sig-rep-tbl
explain select id from rep_t1_g0g1g2 where id = 1 order by id;
Logical ExecutionPlan
LogicalView(tables="reprr_db_g0.rep_t1_g0g1g2", sql="SELECT `rep_t1_g0g1g2`.`id` AS `id` FROM `rep_t1_g0g1g2` AS `rep_t1_g0g1g2` WHERE (`rep_t1_g0g1g2`.`id` = ?) ORDER BY `id`", params="1")
## random-read: rep-join direct-pushdown
explain select t1.id from rep_t1_g0g1g2 t1 join rep_t3_g1g2 t3 on t1.id=t3.id where t1.id = 1 order by t1.id;
Logical ExecutionPlan
LogicalView(tables="reprr_db_g1.rep_t1_g0g1g2,rep_t3_g1g2", sql="SELECT `t1`.`id` AS `id` FROM `rep_t1_g0g1g2` AS `t1` INNER JOIN `rep_t3_g1g2` AS `t3` ON (`t1`.`id` = `t3`.`id`) WHERE (`t1`.`id` = ?) ORDER BY `t1`.`id`", params="1")
## random-read: rep-filter-corr-subquery direct-pushdown
explain select t1.id
from rep_t1_g0g1g2 t1
join rep_t3_g1g2 t3
on t1.id=t3.id
where t1.id = 1 and exists (select rt2.id from rep_t2_g0g1g2 rt2 where rt2.id=t1.id)
order by t1.id;
Logical ExecutionPlan
LogicalView(tables="reprr_db_g1.rep_t1_g0g1g2,rep_t3_g1g2,rep_t2_g0g1g2", sql="SELECT `t1`.`id` AS `id` FROM `rep_t1_g0g1g2` AS `t1` INNER JOIN `rep_t3_g1g2` AS `t3` ON (`t1`.`id` = `t3`.`id`) WHERE ((`t1`.`id` = ?) AND (EXISTS (SELECT `rt2`.`id` AS `id` FROM `rep_t2_g0g1g2` AS `rt2` WHERE (`rt2`.`id` = `t1`.`id`)))) ORDER BY `t1`.`id`", params="1")
## random-read: rep-column-corr-subquery direct-pushdown
explain
select t1.id,
(select rt2.id from rep_t2_g0g1g2 rt2 where rt2.id=t1.id) as rt2_id
from rep_t1_g0g1g2 t1
join rep_t3_g1g2 t3
on t1.id=t3.id
where t1.id = 1
order by t1.id;
Logical ExecutionPlan
LogicalView(tables="reprr_db_g1.rep_t2_g0g1g2,rep_t1_g0g1g2,rep_t3_g1g2", sql="SELECT `t1`.`id` AS `id`, (((SELECT `rt2`.`id` AS `id` FROM `rep_t2_g0g1g2` AS `rt2` WHERE (`rt2`.`id` = `t1`.`id`)))) AS `rt2_id` FROM `rep_t1_g0g1g2` AS `t1` INNER JOIN `rep_t3_g1g2` AS `t3` ON (`t1`.`id` = `t3`.`id`) WHERE (`t1`.`id` = ?) ORDER BY `t1`.`id`", params="1")
## random-read: rep-part-join pushdown
explain select t1.id from rep_t1_g0g1g2 t1 join part_t5_g2 t5 on t1.id=t5.id where t5.id = 1 order by t5.id;
Logical ExecutionPlan
PhyTableOperation(tables="rep_t1_g0g1g2[p3],part_t5_g2[p1]", sql="SELECT `t1`.`id` AS `id` FROM ? AS `t1` INNER JOIN ? AS `t5` ON (`t1`.`id` = `t5`.`id`) WHERE (`t5`.`id` = ?) ORDER BY `t5`.`id`", params="1")
## random-read: rep-join no-pushdown
explain select t3.id from rep_t3_g1g2 t3 join rep_t7_g0g3g4 t7 on t3.id=t7.id where t3.id = 1 order by t3.id;
Logical ExecutionPlan
Project(id="id")
  HashJoin(condition="id = id", type="inner")
    LogicalView(tables="rep_t3_g1g2[p1]", sql="SELECT `id` FROM `rep_t3_g1g2` AS `rep_t3_g1g2` WHERE (`id` = ?) ORDER BY `id`")
    LogicalView(tables="rep_t7_g0g3g4[p1]", sql="SELECT `id` FROM `rep_t7_g0g3g4` AS `rep_t7_g0g3g4` WHERE (`id` = ?)")
## random-read: rep-tbl-join in some lv
explain select t3.id from
rep_t1_g0g1g2 t1
join rep_t3_g1g2 t3 on t1.id=t3.id
join rep_t7_g0g3g4 t7 on t3.id=t7.id where t3.id = 1
order by t3.id;
Logical ExecutionPlan
Project(id="id0")
  HashJoin(condition="id = id AND id0 = id", type="inner")
    LogicalView(tables="rep_t1_g0g1g2[p2],rep_t3_g1g2[p1]", sql="SELECT `rep_t1_g0g1g2`.`id`, `rep_t3_g1g2`.`id` AS `id0` FROM `rep_t1_g0g1g2` AS `rep_t1_g0g1g2` INNER JOIN `rep_t3_g1g2` AS `rep_t3_g1g2` ON ((`rep_t1_g0g1g2`.`id` = ?) AND (`rep_t3_g1g2`.`id` = ?) AND (`rep_t1_g0g1g2`.`id` = `rep_t3_g1g2`.`id`)) WHERE ((`rep_t1_g0g1g2`.`id` = ?) AND (`rep_t3_g1g2`.`id` = ?) AND (`rep_t1_g0g1g2`.`id` = `rep_t3_g1g2`.`id`)) ORDER BY `rep_t3_g1g2`.`id`")
    LogicalView(tables="rep_t7_g0g3g4[p1]", sql="SELECT `id` FROM `rep_t7_g0g3g4` AS `rep_t7_g0g3g4` WHERE (`id` = ?)")
## random-read: rep-part-join in some lv
explain select rt5.id from
rep_t5_g3g4 rt5
join part_t6_g5 pt6 on pt6.id=rt5.id
join rep_t6_g5 rt6 on rt6.id=pt6.id
join rep_t7_g0g3g4 rt7 on rt5.id=rt7.id
where rt5.id = 3
order by rt5.id;
Logical ExecutionPlan
Project(id="id")
  HashJoin(condition="id = id0 AND id0 = id0 AND id = id0 AND id = id", type="inner")
    LogicalView(tables="rep_t5_g3g4[p1],rep_t7_g0g3g4[p2]", sql="SELECT `rep_t5_g3g4`.`id`, `rep_t7_g0g3g4`.`id` AS `id0` FROM `rep_t5_g3g4` AS `rep_t5_g3g4` INNER JOIN `rep_t7_g0g3g4` AS `rep_t7_g0g3g4` ON (`rep_t5_g3g4`.`id` = `rep_t7_g0g3g4`.`id`) WHERE ((`rep_t7_g0g3g4`.`id` = ?) AND (`rep_t5_g3g4`.`id` = ?)) ORDER BY `rep_t5_g3g4`.`id`, (`rep_t7_g0g3g4`.`id` IS NULL), `rep_t7_g0g3g4`.`id`")
    LogicalView(tables="rep_t6_g5,part_t6_g5[p1]", sql="SELECT `rep_t6_g5`.`id`, `part_t6_g5`.`id` AS `id0` FROM `rep_t6_g5` AS `rep_t6_g5` INNER JOIN `part_t6_g5` AS `part_t6_g5` ON (`rep_t6_g5`.`id` = `part_t6_g5`.`id`) WHERE ((`part_t6_g5`.`id` = ?) AND (`rep_t6_g5`.`id` = ?))")
use polardbx;
drop database if exists reprr_db;