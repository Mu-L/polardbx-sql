## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
  drop table if exists dblemur_t10;
create table dblemur_t10
  (a varchar(64)，b bigint)
  partition by udf_hash(
  `a` with udf_params (
  'dble/unitmurmurhash',
  '{"partitionCount": "2","isDigitCheck": "0","leftPaddingChar": "NO"}'
  )
  )
 partitions 2;
insert into dblemur_t10 values ('2', 2);
select * from dblemur_t10 where a='2';
a,b
2,2
select part_route('','dblemur_t10', '2');
part_route('', 'dblemur_t10', '2')
p1
## error_msg: $# routeKey is legal #$
select part_route('','dblemur_t10', '');
routeKey is legal
select part_route('','dblemur_t10', '1234567891234567891234567');
part_route('', 'dblemur_t10', '1234567891234567891234567')
p2
select part_route('','dblemur_t10', 'aaa');
part_route('', 'dblemur_t10', 'aaa')
p2
drop table dblemur_t10;