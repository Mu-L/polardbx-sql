## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
drop table if exists dblemur_t6;
create table dblemur_t6
  (a varchar(64)，b bigint)
  partition by udf_hash(
  `a` with udf_params (
  'dble/unitmurmurhash',
  '{"partitionCount": "2","isDigitCheck": "0","shardingValueMaxLength": "20"}'
  )
  )
partitions 2;
insert into dblemur_t6 values ('2', 2);
select * from dblemur_t6 where a='2';
a,b
2,2
select part_route('','dblemur_t6', '2');
part_route('', 'dblemur_t6', '2')
p1
## error_msg: $# routeKey is legal #$
select part_route('','dblemur_t6', '');
routeKey is legal
select part_route('','dblemur_t6', '123456789012345678901');
part_route('', 'dblemur_t6', '123456789012345678901')
p2
select part_route('','dblemur_t6', 'aaa');
part_route('', 'dblemur_t6', 'aaa')
p2
drop table dblemur_t6;