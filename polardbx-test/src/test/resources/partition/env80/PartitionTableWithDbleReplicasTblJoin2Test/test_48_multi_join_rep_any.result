## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
## LOCALITY_DN_LIST: $dn1, $dn2;
set ENABLE_PUSH_DOWN_AUTO_INCREMENT=true;
set DEFAULT_COLLATION_FOR_UTF8MB4='utf8mb4_bin';
set COLLATION_SERVER='utf8mb4_bin';
set ENABLE_POST_PLANNER_PARTITION_HINT_PRUNING=true;
set ENABLE_REPLICAS_RANDOM_READ= false;
set ENABLE_RANDOM_PHY_TABLE_NAME=false;
set SHOW_PARTITIONS_IN_LOGICALVIEW_FOR_SHOW_CREATE_TABLE=true;
use polardbx;
drop database if exists repjoin48_db;
## USE_DN_LIST_MSG
create database if not exists `repjoin48_db` CHARSET = `utf8mb4` COLLATE = `utf8mb4_general_ci` MODE = 'auto'
LOCALITY = 'dble_config={"group_config":{
  "repjoin48_db_g0":["$dn1","repjoin48_db_g0"],
  "repjoin48_db_g1":["$dn2","repjoin48_db_g1"],
  "repjoin48_db_g2":["$dn1","repjoin48_db_g2"],
  "repjoin48_db_g3":["$dn2","repjoin48_db_g3"],
  "repjoin48_db_g4":["$dn1","repjoin48_db_g4"],
  "repjoin48_db_g5":["$dn2","repjoin48_db_g5"]
}}';
