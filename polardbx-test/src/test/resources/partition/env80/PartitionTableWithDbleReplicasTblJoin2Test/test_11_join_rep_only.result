## joinFilterSubquery pushdown
explain select t1.id from rep_tbl1 t1 join rep_tbl3 t3 on t3.id=t1.id and t1.id in (select t2.id from rep_tbl2 t2) order by t1.id;
Logical ExecutionPlan
LogicalView(tables="repjoin11_db_g1.rep_tbl1,rep_tbl3,rep_tbl2", sql="SELECT `t1`.`id` AS `id` FROM `rep_tbl1` AS `t1` INNER JOIN `rep_tbl3` AS `t3` ON ((`t3`.`id` = `t1`.`id`) AND (`t1`.`id` IN (SELECT `t2`.`id` AS `id` FROM `rep_tbl2` AS `t2`))) ORDER BY `t1`.`id`")
select t1.id from rep_tbl1 t1 join rep_tbl3 t3 on t3.id=t1.id and t1.id in (select t2.id from rep_tbl2 t2) order by t1.id;
