## columnSubquery non-pushdown
explain select t1.id,(select t2.id from rep_tbl3 t2 where t2.id=t1.id) as t2_id from rep_tbl5 t1 order by t1.id;
Logical ExecutionPlan
SemiHashJoin(condition="id = id", type="left", build="inner")
  LogicalView(tables="rep_tbl5[p1]", sql="SELECT `id` FROM `rep_tbl5` AS `rep_tbl5` ORDER BY `id`")
  LogicalView(tables="rep_tbl3[p1]", sql="SELECT `id` FROM `rep_tbl3` AS `rep_tbl3`")
select t1.id,(select t2.id from rep_tbl3 t2 where t2.id=t1.id) as t2_id from rep_tbl5 t1 order by t1.id;
