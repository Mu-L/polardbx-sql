## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
## LOCALITY_DN_LIST: $dn1, $dn2;
set ENABLE_PUSH_DOWN_AUTO_INCREMENT=true;
set DEFAULT_COLLATION_FOR_UTF8MB4='utf8mb4_bin';
set COLLATION_SERVER='utf8mb4_bin';
set ENABLE_POST_PLANNER_PARTITION_HINT_PRUNING=true;
set ENABLE_REPLICAS_RANDOM_READ= false;
use polardbx;
drop database if exists repjoin11_db;
## USE_DN_LIST_MSG
create database if not exists `repjoin11_db` CHARSET = `utf8mb4` COLLATE = `utf8mb4_general_ci` MODE = 'auto'
LOCALITY = 'dble_config={"group_config":{
  "repjoin11_db_g0":["$dn1","repjoin11_db_g0"],
  "repjoin11_db_g1":["$dn2","repjoin11_db_g1"],
  "repjoin11_db_g2":["$dn1","repjoin11_db_g2"],
  "repjoin11_db_g3":["$dn2","repjoin11_db_g3"],
  "repjoin11_db_g4":["$dn1","repjoin11_db_g4"],
  "repjoin11_db_g5":["$dn2","repjoin11_db_g5"]
}}';
use repjoin11_db;
DROP TABLE IF EXISTS `rep_tbl1`;
CREATE TABLE IF NOT EXISTS `rep_tbl1` (
  `id` bigint NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
REPLICAS
LOCALITY='db_set=repjoin11_db_g0,repjoin11_db_g1,repjoin11_db_g2';
DROP TABLE IF EXISTS `rep_tbl2`;
CREATE TABLE IF NOT EXISTS  `rep_tbl2` (
`id` bigint NOT NULL,
PRIMARY KEY (`id`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
REPLICAS
LOCALITY='db_set=repjoin11_db_g0,repjoin11_db_g1,repjoin11_db_g2';
DROP TABLE IF EXISTS `rep_tbl3`;
CREATE TABLE IF NOT EXISTS `rep_tbl3` (
`id` bigint NOT NULL,
PRIMARY KEY (`id`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
REPLICAS
LOCALITY='db_set=repjoin11_db_g1,repjoin11_db_g2';
DROP TABLE IF EXISTS `rep_tbl4`;
CREATE TABLE IF NOT EXISTS `rep_tbl4` (
`id` bigint NOT NULL,
PRIMARY KEY (`id`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
REPLICAS
LOCALITY='db_set=repjoin11_db_g2,repjoin11_db_g3';
DROP TABLE IF EXISTS `rep_tbl5`;
CREATE TABLE IF NOT EXISTS `rep_tbl5` (
`id` bigint NOT NULL,
PRIMARY KEY (`id`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
REPLICAS
LOCALITY='db_set=repjoin11_db_g3,repjoin11_db_g4';
insert into rep_tbl1 values (1),(2),(3),(4),(5);
insert into rep_tbl2 values (1),(2),(3),(4),(5);
insert into rep_tbl3 values (1),(2),(3),(4),(5);
insert into rep_tbl4 values (1),(2),(3),(4),(5);
insert into rep_tbl5 values (1),(2),(3),(4),(5);
## join pushdown
explain select t1.id from rep_tbl1 t1 join rep_tbl2 t2 on t1.id = t2.id order by t1.id;
Logical ExecutionPlan
LogicalView(tables="repjoin11_db_g0.rep_tbl1,rep_tbl2", sql="SELECT `t1`.`id` AS `id` FROM `rep_tbl1` AS `t1` INNER JOIN `rep_tbl2` AS `t2` ON (`t1`.`id` = `t2`.`id`) ORDER BY `t1`.`id`")
select t1.id from rep_tbl1 t1 join rep_tbl2 t2 on t1.id = t2.id order by t1.id;
id
1
