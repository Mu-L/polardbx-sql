## join non-pushdown
explain select t1.id from rep_tbl3 t1 join rep_tbl5 t2 on t1.id = t2.id order by t1.id;
Logical ExecutionPlan
Project(id="id")
  HashJoin(condition="id = id", type="inner")
    LogicalView(tables="rep_tbl3[p1]", sql="SELECT `id` FROM `rep_tbl3` AS `rep_tbl3` ORDER BY `id`")
    LogicalView(tables="rep_tbl5[p1]", sql="SELECT `id` FROM `rep_tbl5` AS `rep_tbl5`")
select t1.id from rep_tbl3 t1 join rep_tbl5 t2 on t1.id = t2.id order by t1.id;
id
1
2
3
4
5
## joinFilterSubquery non-pushdown
explain select t1.id from rep_tbl1 t1 join rep_tbl3 t3 on t3.id=t1.id and t1.id in (select t5.id from rep_tbl5 t5) order by t1.id;
Logical ExecutionPlan
Project(id="id")
  HashJoin(condition="id = id", type="inner")
    SemiHashJoin(condition="id = id", type="semi", build="inner")
      LogicalView(tables="rep_tbl1[p1]", sql="SELECT `id` FROM `rep_tbl1` AS `rep_tbl1` ORDER BY `id`")
      LogicalView(tables="rep_tbl5[p1]", sql="SELECT `id` FROM `rep_tbl5` AS `rep_tbl5`")
    LogicalView(tables="rep_tbl3[p1]", sql="SELECT `id` FROM `rep_tbl3` AS `rep_tbl3`")
## filterSubquery non-pushdown
explain select t1.id from rep_tbl3 t1 where t1.id in (select t2.id from rep_tbl5 t2) order by t1.id;
Logical ExecutionPlan
SemiHashJoin(condition="id = id", type="semi", build="inner")
  LogicalView(tables="rep_tbl3[p1]", sql="SELECT `id` FROM `rep_tbl3` AS `rep_tbl3` ORDER BY `id`")
  LogicalView(tables="rep_tbl5[p1]", sql="SELECT `id` FROM `rep_tbl5` AS `rep_tbl5`")
select t1.id from rep_tbl3 t1 where t1.id in (select t2.id from rep_tbl5 t2) order by t1.id;
