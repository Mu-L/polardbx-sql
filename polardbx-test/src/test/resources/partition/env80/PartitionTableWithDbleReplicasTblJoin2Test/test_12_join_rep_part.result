## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
## LOCALITY_DN_LIST: $dn1, $dn2;
set ENABLE_PUSH_DOWN_AUTO_INCREMENT=true;
set DEFAULT_COLLATION_FOR_UTF8MB4='utf8mb4_bin';
set COLLATION_SERVER='utf8mb4_bin';
set ENABLE_POST_PLANNER_PARTITION_HINT_PRUNING=true;
set ENABLE_REPLICAS_RANDOM_READ= false;
use polardbx;
drop database if exists repjoin12_db;
## USE_DN_LIST_MSG
create database if not exists `repjoin12_db` CHARSET = `utf8mb4` COLLATE = `utf8mb4_general_ci` MODE = 'auto'
LOCALITY = 'dble_config={"group_config":{
  "repjoin12_db_g0":["$dn1","repjoin12_db_g0"],
  "repjoin12_db_g1":["$dn2","repjoin12_db_g1"],
  "repjoin12_db_g2":["$dn1","repjoin12_db_g2"],
  "repjoin12_db_g3":["$dn2","repjoin12_db_g3"],
  "repjoin12_db_g4":["$dn1","repjoin12_db_g4"],
  "repjoin12_db_g5":["$dn2","repjoin12_db_g5"]
}}';
use repjoin12_db;
