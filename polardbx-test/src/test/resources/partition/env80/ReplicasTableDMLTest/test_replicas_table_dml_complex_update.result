UPDATE replicas_dml_tb a , replicas_dml_two_tb b
SET a.integer_test=21
WHERE a.pk=5 and a.pk = b.pk;
-- 验证点：a.pk=5 的 integer_test 字段被更新为 21
SELECT * FROM replicas_dml_tb WHERE pk=5;
pk,integer_test,varchar_test,char_test,blob_test,tinyint_test,smallint_test,mediumint_test,bit_test,bigint_test,float_test,double_test,decimal_test,date_test,time_test,datetime_test,timestamp_test,year_test
5,21,text_5,null,null,null,null,null,null,null,null,null,null,null,null,null,2023-01-06 10:00:00.0,null
-- 注意：这条 SQL 在逻辑上没有做任何事，因为 SET a.pk=5 的条件就是 a.pk=5。但测试用例用它来验证语法和执行的正确性。
UPDATE replicas_dml_tb a , replicas_dml_two_tb b
SET a.pk=5
WHERE a.pk=5 and a.pk = b.pk;
UPDATE replicas_dml_tb a , replicas_dml_two_tb b
SET a.integer_test=21, b.integer_test=21
WHERE a.pk=5 and a.pk = b.pk;
-- 验证点：两张表中 pk=5 的 integer_test 字段都被更新为 21
SELECT * FROM replicas_dml_tb WHERE pk=5;
pk,integer_test,varchar_test,char_test,blob_test,tinyint_test,smallint_test,mediumint_test,bit_test,bigint_test,float_test,double_test,decimal_test,date_test,time_test,datetime_test,timestamp_test,year_test
5,21,text_5,null,null,null,null,null,null,null,null,null,null,null,null,null,2023-01-06 10:00:00.0,null
SELECT * FROM replicas_dml_two_tb WHERE pk=5;
pk,integer_test,varchar_test,char_test,blob_test,tinyint_test,smallint_test,mediumint_test,bit_test,bigint_test,float_test,double_test,decimal_test,date_test,time_test,datetime_test,timestamp_test,year_test
5,21,text_2_5,null,null,null,null,null,null,null,null,null,null,null,null,null,2023-02-06 10:00:00.0,null
UPDATE replicas_dml_tb a , replicas_dml_two_tb b
SET a.pk=5, b.pk=5, a.integer_test=21, b.integer_test=21
WHERE a.pk=5 and a.pk = b.pk;
UPDATE replicas_dml_tb a , replicas_dml_two_tb b
SET a.integer_test=21, a.timestamp_test='2023-05-26 20:12:12', b.integer_test=21
WHERE a.pk=5 and a.pk = b.pk;
-- 验证点：a 表的 integer_test 和 timestamp_test 被更新, b 表的 integer_test 被更新
SELECT * FROM replicas_dml_tb WHERE pk=5;
pk,integer_test,varchar_test,char_test,blob_test,tinyint_test,smallint_test,mediumint_test,bit_test,bigint_test,float_test,double_test,decimal_test,date_test,time_test,datetime_test,timestamp_test,year_test
5,21,text_5,null,null,null,null,null,null,null,null,null,null,null,null,null,2023-05-26 20:12:12.0,null
SELECT * FROM replicas_dml_two_tb WHERE pk=5;
pk,integer_test,varchar_test,char_test,blob_test,tinyint_test,smallint_test,mediumint_test,bit_test,bigint_test,float_test,double_test,decimal_test,date_test,time_test,datetime_test,timestamp_test,year_test
5,21,text_2_5,null,null,null,null,null,null,null,null,null,null,null,null,null,2023-02-06 10:00:00.0,null
UPDATE replicas_dml_tb a , replicas_dml_two_tb b
SET a.pk=5, b.pk=5, a.timestamp_test='2023-05-26 20:12:12', a.integer_test=21, b.integer_test=21
WHERE a.pk=5 and a.pk = b.pk;
UPDATE replicas_dml_tb a , replicas_dml_two_tb b
SET a.pk=5, b.pk=5, a.timestamp_test=CURRENT_TIMESTAMP(), a.integer_test=21, b.integer_test=21, b.timestamp_test=CURRENT_TIMESTAMP()
WHERE a.pk=5 and a.pk = b.pk;
use polardbx;
drop database if exists test_replicas_db;