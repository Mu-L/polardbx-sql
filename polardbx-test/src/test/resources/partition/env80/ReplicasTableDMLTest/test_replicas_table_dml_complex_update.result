## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
## LOCALITY_DN_LIST: $dn1, $dn2;
use polardbx;
drop database if exists test_replicas_db;
set session FORBID_CROSS_GROUP_WRITE_FOR_EXPLICIT_TRX=true;
set session ENABLE_PUSH_DOWN_AUTO_INCREMENT = true;
set session sql_mode='STRICT_TRANS_TABLES,NO_AUTO_VALUE_ON_ZERO';
## USE_DN_LIST_MSG
create database if not exists test_replicas_db charset = utf8 collate = utf8_general_ci mode = 'auto' locality='dble_config={"group_config":{"p1":["$dn1","p_01"],"p2":["$dn1","p_02"],"p3":["$dn2","p_03"],"p4":["$dn2","p_04"]}}';
use test_replicas_db;
CREATE TABLE `replicas_dml_tb` (
`pk` bigint(20) NOT NULL,
`integer_test` int(11) DEFAULT NULL,
`varchar_test` varchar(255) DEFAULT NULL,
`char_test` char(255) DEFAULT NULL,
`blob_test` blob,
`tinyint_test` tinyint(4) DEFAULT NULL,
`smallint_test` smallint(6) DEFAULT NULL,
`mediumint_test` mediumint(9) DEFAULT NULL,
`bit_test` bit(1) DEFAULT NULL,
`bigint_test` bigint(20) DEFAULT NULL,
`float_test` float DEFAULT NULL,
`double_test` double DEFAULT NULL,
`decimal_test` decimal(10, 0) DEFAULT NULL,
`date_test` date DEFAULT NULL,
`time_test` time DEFAULT NULL,
`datetime_test` datetime DEFAULT NULL,
`timestamp_test` timestamp NULL DEFAULT NULL,
`year_test` year(4) DEFAULT NULL,
PRIMARY KEY (`pk`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 replicas locality='db_set=p1,p2';
CREATE TABLE `replicas_dml_two_tb` (
`pk` bigint(20) NOT NULL,
`integer_test` int(11) DEFAULT NULL,
`varchar_test` varchar(255) DEFAULT NULL,
`char_test` char(255) DEFAULT NULL,
`blob_test` blob,
`tinyint_test` tinyint(4) DEFAULT NULL,
`smallint_test` smallint(6) DEFAULT NULL,
`mediumint_test` mediumint(9) DEFAULT NULL,
`bit_test` bit(1) DEFAULT NULL,
`bigint_test` bigint(20) DEFAULT NULL,
`float_test` float DEFAULT NULL,
`double_test` double DEFAULT NULL,
`decimal_test` decimal(10, 0) DEFAULT NULL,
`date_test` date DEFAULT NULL,
`time_test` time DEFAULT NULL,
`datetime_test` datetime DEFAULT NULL,
`timestamp_test` timestamp NULL DEFAULT NULL,
`year_test` year(4) DEFAULT NULL,
PRIMARY KEY (`pk`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 replicas locality='db_set=p1,p2';
