## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
set TTL_DEBUG_USE_GSI_FOR_COLUMNAR_ARC_TBL = true;
USE polardbx;
DROP DATABASE IF EXISTS test_ttl_arc_npe_db;
CREATE DATABASE IF NOT EXISTS test_ttl_arc_npe_db mode='auto' DEFAULT DEFAULT COLLATE utf8mb4_bin;
USE test_ttl_arc_npe_db;
CREATE TABLE ttl_npe_t1(
a int not null auto_increment,
b datetime default current_timestamp,
c varchar(64) default 'hello',
primary key(a)
)
TTL = TTL_DEFINITION(
TTL_ENABLE = 'OFF',
TTL_EXPR = `b` EXPIRE AFTER 30 DAY TIMEZONE '+08:00',
TTL_JOB = CRON '0 0 2 */1 * ? *' TIMEZONE '+08:00'
)
partition by key(a) partitions 2;
show create table ttl_npe_t1;
Table,Create Table
ttl_npe_t1,CREATE TABLE `ttl_npe_t1` (
	`a` int NOT NULL AUTO_INCREMENT,
	`b` datetime DEFAULT CURRENT_TIMESTAMP,
	`c` varchar(64) COLLATE utf8mb4_bin DEFAULT 'hello',
	PRIMARY KEY (`a`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 DEFAULT COLLATE = utf8mb4_bin TTL = TTL_DEFINITION ( TTL_ENABLE = 'OFF', TTL_EXPR = `b` EXPIRE AFTER 30 DAY TIMEZONE '+08:00', TTL_JOB = CRON '0 0 2 */1 * ? *', TTL_CLEANUP = 'OFF', TTL_PART_INTERVAL = INTERVAL(1, DAY), ARCHIVE_TYPE = 'ROW', ARCHIVE_TABLE_NAME = '', ARCHIVE_TABLE_PRE_ALLOCATE = 12, ARCHIVE_TABLE_POST_ALLOCATE = 64 )
PARTITION BY KEY(`a`)
PARTITIONS 2
CREATE INDEX idx_npe_t1_b ON ttl_npe_t1(b);
