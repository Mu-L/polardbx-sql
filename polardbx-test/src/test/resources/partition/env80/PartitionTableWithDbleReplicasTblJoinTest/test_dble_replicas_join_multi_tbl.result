Logical ExecutionPlan
LogicalView(tables="mydbledb3_g2.r_g2g3,r_all_t1", sql="SELECT `t1`.`a` AS `a` FROM `r_g2g3` AS `t1` INNER JOIN `r_all_t1` AS `t2` ON (`t1`.`a` = `t2`.`a`) WHERE (`t2`.`a` = ?)", params="100")
## push join for replicas_tbl at all join replicas_tbl at g2g3
explain select t1.a from r_all_t1 t1 join r_g2g3 t2 on t1.a=t2.a where t2.a=100;
Logical ExecutionPlan
LogicalView(tables="mydbledb3_g2.r_all_t1,r_g2g3", sql="SELECT `t1`.`a` AS `a` FROM `r_all_t1` AS `t1` INNER JOIN `r_g2g3` AS `t2` ON (`t1`.`a` = `t2`.`a`) WHERE (`t2`.`a` = ?)", params="100")
## route a=100 : p3
explain select * from part_tbl_t1 where a in (100);
Logical ExecutionPlan
Gather(concurrent=true)
  LogicalView(tables="part_tbl_t1[p3]", sql="SELECT `a` FROM `part_tbl_t1` AS `part_tbl_t1` WHERE (`a` IN(?))")
## route a=100 : p6
explain select * from part_tbl_t1 where a in (200);
