## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
## LOCALITY_DN_LIST: $dn1, $dn2;
set ROUTE_TUPLE_USE_PRECHECK_BY_UDF_FUNC=true;
set ROUTE_TUPLE_IGNORE_BAD_VALUE_TYPE_CAST=true;
set ENABLE_PUSH_DOWN_AUTO_INCREMENT=true;
create table dblemurhash_exam5 (
  id varchar(32) not null primary key,
  name varchar(20)
  )
  partition by UDF_HASH(
  `id` with udf_params(
  'dble/unitmurmurhash',
  '{
"partitionCount" : "2",
"shardingValueMaxLength" : "20",
"isDigitCheck" : "0",
"leftPaddingChar" : "A"
}'
  )
)
partitions 2;
insert into dblemurhash_exam5(id,name) values('12345678912345678912345','a');
select * from dblemurhash_exam5 where id='12345678912345678912345';
id,name
12345678912345678912345,a
insert into dblemurhash_exam5(id,name) values('abc','a');
select * from dblemurhash_exam5 where id='abc';
id,name
abc,a
## error_msg: $# routeField is null or "" ! #$
insert into dblemurhash_exam5(id,name) values('','a');
routeField is null or "" !
## error_msg: $# routeField is null or "" ! #$
insert into dblemurhash_exam5(id,name) values(null,'a');
routeField is null or "" !
insert into dblemurhash_exam5(id,name) values('b','a');
select * from dblemurhash_exam5 where id='b';
id,name
b,a