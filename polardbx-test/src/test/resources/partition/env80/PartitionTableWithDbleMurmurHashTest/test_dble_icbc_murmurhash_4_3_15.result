## DISABLE_FAST_SQL_PARSER
## RESERVE_SEMICOLONS_FLAG
## LOCALITY_DN_LIST: $dn1, $dn2;
set ROUTE_TUPLE_USE_PRECHECK_BY_UDF_FUNC=true;
set ROUTE_TUPLE_IGNORE_BAD_VALUE_TYPE_CAST=true;
set ENABLE_PUSH_DOWN_AUTO_INCREMENT=true;
create table dblemurhash_15 (
  id varchar(32) not null primary key,
  name varchar(20)
  )
  partition by UDF_HASH(
  `id` with udf_params(
  'dble/unitmurmurhash',
  '{
"partitionCount" : "2",
"isDigitCheck" : "0"
}'
  )
)
partitions 2;
insert into dblemurhash_15(id,name) values('12345678912345678912345671','a');
select * from dblemurhash_15 where id = '12345678912345678912345671';
id,name
12345678912345678912345671,a
insert into dblemurhash_15(id,name) values('abb','a');
select * from dblemurhash_15 where id = 'abb';
id,name
abb,a
## error_msg: $# routeField is null or "" ! #$
insert into dblemurhash_15(id) values("");
routeField is null or "" !
