create table dble_replicas_storage_part2 (
  a bigint not null，
  b bigint,
  primary key(a)
) charset utf8mb4 collate utf8mb4_general_ci
replicas
locality='db_set=dblesp_g2,dblesp_g3,dblesp_g4'
/*!storage
partition by key(a)
partitions 8
*/;
show create table dble_replicas_storage_part2;
Table,Create Table
dble_replicas_storage_part2,CREATE TABLE `dble_replicas_storage_part2` (
	`a` bigint NOT NULL,
	`b` bigint DEFAULT NULL,
	PRIMARY KEY (`a`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
/*!STORAGE
PARTITION BY KEY (a)
PARTITIONS 8
*/
/* LOCALITY='db_set=dblesp_g2,dblesp_g3,dblesp_g4' */
REPLICAS
insert into dble_replicas_storage_part2 values (1,1),(3,3);
select a,b from dble_replicas_storage_part2　where (a,b) in ((1,1),(3,3))  order by a,b;
a,b
1,1
3,3
