create table part_with_sp_list(
a bigint not null,
b bigint,
primary key(a))
charset utf8mb4 collate utf8mb4_bin
/*!storage
partition by list columns(a)
(
partition p1 values in(1),
partition p2 values in(10)
)
*/
partition by key(b)
partitions 1;
show create table part_with_sp_list;
Table,Create Table
part_with_sp_list,CREATE TABLE `part_with_sp_list` (
	`a` bigint NOT NULL,
	`b` bigint DEFAULT NULL,
	PRIMARY KEY (`a`),
	KEY `auto_shard_key_b` USING BTREE (`b`)
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 DEFAULT COLLATE = utf8mb4_bin
/*!STORAGE
PARTITION BY LIST  COLUMNS(a)
(PARTITION p1 VALUES IN (1) ENGINE = InnoDB,
 PARTITION p2 VALUES IN (10) ENGINE = InnoDB)
*/
PARTITION BY KEY(`b`)
PARTITIONS 1
