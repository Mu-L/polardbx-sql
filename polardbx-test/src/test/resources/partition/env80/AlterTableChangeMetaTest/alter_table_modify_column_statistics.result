DROP DATABASE IF EXISTS test_statistics
CREATE DATABASE test_statistics MODE auto
USE test_statistics
DROP TABLE IF EXISTS t_statistics
CREATE TABLE t_statistics (
	id int,
	name varchar(60),
	NAME2 varchar(60),
	Name3 varchar(60),
	PRIMARY KEY (id)
)
PARTITION BY KEY (id) PARTITIONS 4
ALTER TABLE t_statistics
	ADD INDEX idx_name (name)
ALTER TABLE t_statistics
	ADD INDEX idx_name2 (name, name3)
ALTER TABLE t_statistics
	ADD INDEX idx_name3 (name, name2(10), name3)
ALTER TABLE t_statistics
	ADD INDEX idx_name4 (nAme(5))
ALTER TABLE t_statistics
	ADD INDEX idx_name5 (naMe(4), name2(10))
ALTER TABLE t_statistics
	ADD INDEX idx_name6 (name(10), namE2(10), name3(10))
SHOW CREATE TABLE t_statistics
TABLE,CREATE TABLE
t_statistics,CREATE TABLE `t_statistics` (
	`id` int(11) NOT NULL,
	`name` varchar(60) DEFAULT NULL,
	`NAME2` varchar(60) DEFAULT NULL,
	`Name3` varchar(60) DEFAULT NULL,
	PRIMARY KEY (`id`),
	KEY `idx_name` (`name`),
	KEY `idx_name2` (`name`, `Name3`),
	KEY `idx_name3` (`name`, `NAME2`(10), `Name3`),
	KEY `idx_name4` (`name`(5)),
	KEY `idx_name5` (`name`(4), `NAME2`(10)),
	KEY `idx_name6` (`name`(10), `NAME2`(10), `Name3`(10))
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4
PARTITION BY KEY(`id`)
PARTITIONS 4
SELECT *
FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_SCHEMA = 'test_statistics'
	AND table_name = 't_statistics'
ORDER BY index_name, seq_in_index
